        {% else %}
          {% render 'premium-product-card', dummy_title: 'Advanced Snail 96 Mucin Power Essence', dummy_price: 'Rs. 4,600', dummy_compare_price: 'Rs. 5,800', dummy_category: 'Essence', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Bakuchiol Natural Retinol-Alternative Serum', dummy_price: 'Rs. 5,100', dummy_compare_price: 'Rs. 6,400', dummy_category: 'Serums & Actives', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Centella Calming Daily Sun Fluid SPF 50', dummy_price: 'Rs. 3,300', dummy_compare_price: 'Rs. 4,200', dummy_category: 'Sun Protection', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Matcha Green Tea Antioxidant Cleanser', dummy_price: 'Rs. 2,750', dummy_compare_price: 'Rs. 3,600', dummy_category: 'Cleansers', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Ginseng Essence Water Revitalizing Toner', dummy_price: 'Rs. 3,200', dummy_compare_price: 'Rs. 4,100', dummy_category: 'Toners', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&q=80&w=800' %}

          {% render 'premium-product-card', dummy_title: 'Glutathione Radiance Boosting Ampoule', dummy_price: 'Rs. 5,600', dummy_compare_price: 'Rs. 7,000', dummy_category: 'Ampoules', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1608248597359-58807d9b9d36?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Panthenol 10% Barrier Recovery Balm', dummy_price: 'Rs. 3,900', dummy_compare_price: 'Rs. 4,900', dummy_category: 'Moisturizers', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1567928815116-2f08816c7cfc?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Caffeine 5% Energizing Eye Solution', dummy_price: 'Rs. 3,400', dummy_compare_price: 'Rs. 4,400', dummy_category: 'Eye Care', dummy_badge: 'SALE', dummy_image: 'https://images.unsplash.com/photo-1535585209827-a15fcdbc4c2d?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Azelaic Acid 10% Skin Clearing Cream', dummy_price: 'Rs. 4,100', dummy_compare_price: 'Rs. 5,200', dummy_category: 'Treatments', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Ceramide Lip Peptide Therapy Treatment', dummy_price: 'Rs. 1,950', dummy_compare_price: 'Rs. 2,600', dummy_category: 'Lip Therapy', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?auto=format&fit=crop&q=80&w=800' %}
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium Products (5x2)",
  "tag": "section",
  "class": "section-premium-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Clinical Formulas"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Skincare Essentials"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 5,
      "max": 20,
      "step": 5,
      "default": 10,
      "label": "Products to show (Multiples of 5)"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "select",
      "id": "sample_preset",
      "label": "Sample Data Preset (When collection empty)",
      "options": [
        { "value": "new_arrivals", "label": "New Arrivals" },
        { "value": "best_sellers", "label": "Best Sellers" },
        { "value": "featured", "label": "Featured Formulas" }
      ],
      "default": "new_arrivals"
    }
  ],
  "presets": [
    {
      "name": "Premium Products (5x2)",
      "settings": {
        "title": "New Skincare Arrivals",
        "sample_preset": "new_arrivals"
      }
    }
  ]
}
{% endschema %}