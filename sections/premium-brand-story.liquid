<div class="premium-brand-story-section">
  <!-- Glowing Top & Bottom Amber Accent Lines -->
  <div class="premium-promo-accent-top"></div>
  <div class="premium-promo-accent-bottom"></div>

  {% if section.settings.image != blank %}
    <img
      src="{{ section.settings.image | image_url: width: 2400 }}"
      alt="{{ section.settings.heading | escape }}"
      class="premium-brand-story-bg"
      loading="lazy"
      width="2400"
      height="1200"
    >
  {% elsif section.settings.image_url != blank %}
    <img
      src="{{ section.settings.image_url }}"
      alt="{{ section.settings.heading | escape }}"
      class="premium-brand-story-bg"
      loading="lazy"
      width="2400"
      height="1200"
    >
  {% else %}
    <img
      src="{{ 'elvora_about_philosophy_banner.jpg' | asset_url }}"
      alt="{{ section.settings.heading | default: 'Our Formulation Philosophy' | escape }}"
      class="premium-brand-story-bg"
      loading="lazy"
      width="2400"
      height="1200"
    >
  {% endif %}

  <div class="premium-brand-story-overlay"></div>

  <div style="max-width: 1440px; width: 100%; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 10; display: flex; justify-content: flex-end; box-sizing: border-box;">
    <div class="premium-brand-story-card">
      <div class="premium-brand-story-eyebrow">
        <span>✦</span>
        <span>{{ section.settings.eyebrow | default: 'Our Formulation Philosophy' }}</span>
      </div>

      <h2 class="premium-brand-story-heading">
        {{ section.settings.heading | default: 'Science-Backed Botanical Skincare' }}
      </h2>

      <div class="premium-brand-story-body">
        {{ section.settings.body | default: '<p>At ELVORA, we harmonize high-potency clinical actives with pure botanical extracts to heal, protect, and illuminate your skin. Every formula is dermatologically tested, cruelty-free, and formulated without harmful sulfates, parabens, or synthetic fragrances.</p><p>From targeted dark spot correction to barrier-strengthening hydration, we empower your skin to achieve its healthiest, most radiant glow.</p>' }}
      </div>

      <div>
        <a href="{{ section.settings.cta_link | default: '/pages/about' }}" class="premium-brand-story-cta">
          <span>{{ section.settings.cta_text | default: 'Discover Our Story' }}</span>
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium Brand Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for Pure Distinction"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Story Content",
      "default": "<p>At Elvora, we believe fashion is an effortless blend of elegance and modern craftsmanship. Each collection is meticulously designed with handpicked materials, timeless silhouettes, and an uncompromising commitment to detail.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Background Image URL (Fallback)"
    }
  ],
  "presets": [
    {
      "name": "Premium Brand Story"
    }
  ]
}
{% endschema %}

