{% comment %}
  ELVORA Skincare - Activate Account Template
{% endcomment %}

<div class="elvora-auth-page-wrapper">
  <div class="elvora-auth-container" style="max-width: 540px;">
    
    <div class="elvora-auth-form-card" style="width: 100%;">
      <div class="elvora-auth-header">
        <span class="elvora-auth-kicker">Welcome to ELVORA</span>
        <h1 class="elvora-auth-title">Activate Your Account</h1>
        <p class="elvora-auth-subtitle">
          Create your password to activate your ELVORA customer account.
        </p>
      </div>

      {% form 'activate_customer_password', class: 'elvora-auth-form' %}
        {% if form.errors %}
          <div class="elvora-auth-alert elvora-auth-alert-error" role="alert">
            <span>{{ form.errors | default_errors }}</span>
          </div>
        {% endif %}

        <div class="elvora-form-field">
          <label for="CustomerPassword" class="elvora-form-label">Password *</label>
          <input type="password" name="customer[password]" id="CustomerPassword" class="elvora-form-input" required minlength="6" placeholder="••••••••">
        </div>

        <div class="elvora-form-field">
          <label for="CustomerPasswordConfirmation" class="elvora-form-label">Confirm Password *</label>
          <input type="password" name="customer[password_confirmation]" id="CustomerPasswordConfirmation" class="elvora-form-input" required minlength="6" placeholder="••••••••">
        </div>

        <div class="elvora-auth-actions">
          <button type="submit" class="elvora-btn-auth-primary">
            <span>Activate Account</span>
          </button>
        </div>
      {% endform %}
    </div>

  </div>
</div>

