<div class="premium-categories-wrapper">
  <div class="premium-section-header">
    <div>
      <span class="premium-eyebrow">
        <span class="premium-eyebrow-dot"></span>
        {{ section.settings.eyebrow | default: 'Targeted Care' }}
      </span>
      <h2 class="premium-section-title">
        {{ section.settings.title | default: 'Shop by Skincare Category' }}
        <span class="premium-section-title-line"></span>
      </h2>
    </div>

    {% if section.settings.show_view_all %}
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="premium-view-all-btn">
        View All
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="category-accordion-container">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '/collections/all' }}"
        class="category-accordion-item"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.title | escape }}"
            class="category-accordion-img"
            loading="lazy"
            width="1200"
            height="800"
          >
        {% elsif block.settings.image_url != blank %}
          <img
            src="{{ block.settings.image_url }}"
            alt="{{ block.settings.title | escape }}"
            class="category-accordion-img"
            loading="lazy"
            width="1200"
            height="800"
          >
        {% else %}
          <img
            src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=1200"
            alt="{{ block.settings.title | escape }}"
            class="category-accordion-img"
            loading="lazy"
            width="1200"
            height="800"
          >
        {% endif %}

        <!-- Clean bottom-only subtle fade for text (NO SHADE ON IMAGE) -->
        <div class="category-accordion-clean-scrim"></div>

        <!-- Panel Number (01, 02, etc.) -->
        <div class="category-accordion-num">
          <span>0{{ forloop.index }}</span>
        </div>

        <!-- Content -->
        <div class="category-accordion-content">
          <h3 class="category-accordion-title">{{ block.settings.title }}</h3>
          <div class="category-accordion-expanded-info">
            <span class="category-accordion-count">{{ block.settings.subtitle | default: 'Explore Collection' }}</span>
            <span class="category-accordion-pill-btn">
              Explore Collection
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Premium Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Targeted Care"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Shop by Skincare Category"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Serums & Actives"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "32 Formulas"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (Fallback)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Serums & Actives",
            "subtitle": "32 Formulas",
            "image_url": "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=1200"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Cleansers & Toners",
            "subtitle": "24 Products",
            "image_url": "https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&q=80&w=1200"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Barrier Moisturizers",
            "subtitle": "18 Creams",
            "image_url": "https://images.unsplash.com/photo-1608248597359-58807d9b9d36?auto=format&fit=crop&q=80&w=1200"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Sunscreen & SPF",
            "subtitle": "14 Formulas",
            "image_url": "https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&q=80&w=1200"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Eye & Night Care",
            "subtitle": "19 Treatments",
            "image_url": "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=1200"
          }
        }
      ]
    }
  ]
}
{% endschema %}