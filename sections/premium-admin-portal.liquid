        <span class="elvora-pulse-dot"></span>
        <span class="elvora-store-status">Storefront: <strong>LIVE & SYNCED</strong></span>
        <span class="elvora-top-sep">&bull;</span>
        <span>Orders: <strong id="top-orders-count">156</strong></span>
        <span class="elvora-top-sep">&bull;</span>
        <span>Sales: <strong>Rs. 842,500</strong></span>
