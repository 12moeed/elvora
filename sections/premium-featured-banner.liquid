{% comment %}
  ELVORA Skincare - Premium Featured Banner (Image Only)
  Exact same full-bleed width & dimensions as Sale Banner, but 100% pure image with NO text overlay.
  Full-width edge-to-edge, drag-and-drop independent section.
{% endcomment %}

<div class="premium-promo-section premium-featured-banner-section height-{{ section.settings.banner_height | default: 'match_sale' }}">
  
  {% if section.settings.show_gold_accents %}
    <div class="premium-promo-accent-top" aria-hidden="true"></div>
    <div class="premium-promo-accent-bottom" aria-hidden="true"></div>
  {% endif %}

  {% if section.settings.banner_link != blank %}
    <a
      href="{{ section.settings.banner_link }}"
      class="premium-banner-clickable-wrap"
      {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      aria-label="{{ section.settings.accessibility_alt | default: 'ELVORA Featured Banner' | escape }}"
    >
  {% else %}
    <div class="premium-banner-clickable-wrap">
  {% endif %}

    {% if section.settings.image_desktop != blank or section.settings.image_url_desktop != blank %}
      <picture class="premium-banner-picture">
        <!-- Mobile source -->
        {% if section.settings.image_mobile != blank %}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
        {% elsif section.settings.image_url_mobile != blank %}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_url_mobile }}">
        {% endif %}

        <!-- Desktop source -->
        {% if section.settings.image_desktop != blank %}
          <img
            src="{{ section.settings.image_desktop | image_url: width: 2600 }}"
            alt="{{ section.settings.accessibility_alt | default: 'ELVORA Featured Banner' | escape }}"
            class="premium-banner-img"
            loading="lazy"
            width="2600"
            height="1000"
          >
        {% else %}
          <img
            src="{{ section.settings.image_url_desktop }}"
            alt="{{ section.settings.accessibility_alt | default: 'ELVORA Featured Banner' | escape }}"
            class="premium-banner-img"
            loading="lazy"
            width="2600"
            height="1000"
          >
        {% endif %}
      </picture>
    {% else %}
      <!-- Empty State inside Shopify Theme Editor -->
      <div class="premium-banner-placeholder-box">
        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color: #D4AF37; margin: 0 auto 0.75rem;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
        </svg>
        <h3 style="font-family: var(--font-heading); color: #FFF6E8; font-size: 1.25rem; margin-bottom: 0.35rem; font-weight: 700;">Featured Banner (Image Only)</h3>
        <p style="color: rgba(255, 240, 220, 0.75); font-size: 0.9rem; margin: 0;">Shopify Theme Editor (Customize) se yahan apna graphic banner upload karein.</p>
      </div>
    {% endif %}

  {% if section.settings.banner_link != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}

</div>

<style>
  /* Full-bleed Edge-to-Edge Container (Exact same width as Sale Banner) */
  .premium-featured-banner-section {
    position: relative !important;
    overflow: hidden !important;
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding: 0 !important;
    display: block !important;
    background: #140A05 !important;
    grid-column: 1 / -1 !important;
  }

  .premium-banner-clickable-wrap {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    position: relative;
  }

  .premium-banner-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Height Modes matching Sale Banner */
  .premium-featured-banner-section.height-match_sale .premium-banner-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .premium-featured-banner-section.height-compact .premium-banner-img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .premium-featured-banner-section.height-large .premium-banner-img {
    width: 100%;
    height: 650px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .premium-featured-banner-section.height-natural .premium-banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 767px) {
    .premium-featured-banner-section.height-match_sale .premium-banner-img {
      height: 380px;
    }
    .premium-featured-banner-section.height-compact .premium-banner-img {
      height: 280px;
    }
    .premium-featured-banner-section.height-large .premium-banner-img {
      height: 480px;
    }
  }

  .premium-banner-placeholder-box {
    width: 100%;
    min-height: 420px;
    padding: 5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1C0C04 0%, #35180A 50%, #1C0C04 100%);
    border: 1.5px dashed rgba(212, 175, 55, 0.45);
    text-align: center;
    box-sizing: border-box;
  }
</style>

{% schema %}
{
  "name": "Featured Image Banner",
  "tag": "section",
  "class": "section section--full-width section--full-bleed",
  "settings": [
    {
      "type": "header",
      "content": "Banner Images (No Text Overlay)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Banner Image",
      "info": "Recommended: 1920x600px ya 2400x800px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image (Optional)",
      "info": "Recommended: 800x1000px ya 1080x1350px. Khali chorne par desktop image chalegi."
    },
    {
      "type": "text",
      "id": "image_url_desktop",
      "label": "Desktop Image Direct URL (Fallback)"
    },
    {
      "type": "text",
      "id": "image_url_mobile",
      "label": "Mobile Image Direct URL (Fallback)"
    },
    {
      "type": "header",
      "content": "Click Link & Actions"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Click Link (Optional)",
      "info": "Click karne par customer kahan jaye (e.g. collection ya product). Khali chorne par click off hoga."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new browser tab",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_alt",
      "label": "Image Alt Text (SEO)",
      "default": "ELVORA Luxury Skincare Featured Banner"
    },
    {
      "type": "header",
      "content": "Banner Height"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Height Mode",
      "options": [
        {
          "value": "match_sale",
          "label": "Same as Sale Banner (520px Full Width)"
        },
        {
          "value": "natural",
          "label": "Natural (Original Image Ratio)"
        },
        {
          "value": "compact",
          "label": "Compact Height (400px)"
        },
        {
          "value": "large",
          "label": "Large Height (650px)"
        }
      ],
      "default": "match_sale"
    },
    {
      "type": "checkbox",
      "id": "show_gold_accents",
      "label": "Show Glowing Gold Border Lines",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Image Banner"
    }
  ]
}
{% endschema %}
