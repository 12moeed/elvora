  /* ==========================================================================
     INTERACTIVE SEARCH MODAL STYLES
     ========================================================================== */
  .elvora-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5rem 1rem 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  .elvora-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .elvora-modal-dialog {
    width: 100%;
    max-width: 680px;
    transform: translateY(-20px) scale(0.97);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elvora-modal-backdrop.is-open .elvora-modal-dialog {
    transform: translateY(0) scale(1);
  }

  .elvora-search-modal-card {
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .elvora-search-modal-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .elvora-search-modal-form {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .elvora-search-modal-icon {
    color: #C59B27;
    flex-shrink: 0;
  }

  .elvora-search-modal-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.1rem;
    font-family: inherit;
    color: #111827;
    background: transparent;
  }

  .elvora-search-modal-input::placeholder {
    color: #9ca3af;
  }

  .elvora-modal-close-btn {
    background: #f3f4f6;
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .elvora-modal-close-btn:hover {
    background: #e5e7eb;
    color: #111827;
  }

  .elvora-search-modal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-height: 70vh;
    overflow-y: auto;
  }

  .elvora-suggestions-label {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #C59B27;
    margin: 0 0 0.85rem 0;
  }

  .elvora-suggestion-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .elvora-tag-pill {
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    background: #fdf2f8;
    color: #9d174d;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .elvora-tag-pill:hover {
    background: #fce7f3;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(212, 175, 55, 0.15);
  }

  .elvora-quick-collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.6rem;
  }

  .elvora-quick-col-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
    background: #f9fafb;
    color: #374151;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .elvora-quick-col-link:hover {
    background: #fdf2f8;
    color: #C59B27;
  }

  .elvora-q-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #C59B27;
  }

  /* ==========================================================================
     MOBILE NAVIGATION DRAWER STYLES
     ========================================================================== */
  .elvora-drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 2500;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s;
  }

  .elvora-drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .elvora-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 88vw;
    max-width: 380px;
    height: 100%;
    background: #ffffff;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .elvora-drawer-backdrop.is-open .elvora-drawer-panel {
    transform: translateX(0);
  }

  .elvora-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .elvora-drawer-brand {
    display: flex;
    flex-direction: column;
  }

  .elvora-drawer-title {
    font-family: var(--font-heading-family, 'Playfair Display', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 800;
    color: #111827;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .elvora-drawer-subtitle {
    font-size: 0.58rem;
    font-weight: 700;
    color: #C59B27;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .elvora-drawer-close-btn {
    background: #f3f4f6;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b5563;
    cursor: pointer;
  }

  .elvora-drawer-search {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .elvora-drawer-search-form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 9999px;
    padding: 0.55rem 1rem;
    color: #6b7280;
  }

  .elvora-drawer-search-input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 0.9rem;
    font-family: inherit;
    color: #111827;
  }

  .elvora-drawer-nav {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .elvora-drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1f2937;
    transition: all 0.15s ease;
    border: none;
    background: transparent;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }

  .elvora-drawer-link:hover {
    background: #fdf2f8;
    color: #C59B27;
  }

  .elvora-drawer-sale-link {
    color: #C59B27;
    background: #fdf2f8;
  }

  .elvora-drawer-badge {
    background: #C59B27;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 9999px;
  }

  /* Accordion inside mobile drawer */
  .elvora-drawer-accordion {
    display: flex;
    flex-direction: column;
  }

  .elvora-accordion-chevron {
    transition: transform 0.25s ease;
  }

  .elvora-drawer-accordion.is-open .elvora-accordion-chevron {
    transform: rotate(180deg);
  }

  .elvora-accordion-content {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.35rem 0 0.5rem 1rem;
  }

  .elvora-drawer-accordion.is-open .elvora-accordion-content {
    display: flex;
  }

  .elvora-drawer-sublink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #4b5563;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .elvora-drawer-sublink:hover {
    background: #fdf2f8;
    color: #C59B27;
  }

  .elvora-highlight-sublink {
    color: #C59B27;
    font-weight: 700;
  }

  /* Drawer Footer */
  .elvora-drawer-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid #f3f4f6;
    background: #fafafa;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .elvora-support-title {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #C59B27;
    margin: 0 0 0.25rem 0;
  }

  .elvora-support-sub {
    font-size: 0.78rem;
    color: #6b7280;
    margin: 0;
  }

  .elvora-drawer-auth {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .elvora-drawer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }

  .elvora-drawer-btn-primary {
    background: linear-gradient(135deg, #46240E 0%, #784119 50%, #46240E 100%);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
  }

  .elvora-drawer-btn-secondary {
    background: #ffffff;
    color: #374151;
    border: 1px solid #e5e7eb;
  }

  /* ── Predictive Search Live Results ── */
  .elvora-predictive-results-wrap {
    margin-top: 1.25rem;
    max-height: 58vh;
    overflow-y: auto;
    padding-right: 4px;
  }

  .elvora-predictive-results-wrap::-webkit-scrollbar {
    width: 5px;
  }
  .elvora-predictive-results-wrap::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.4);
    border-radius: 9999px;
  }

  .elvora-predictive-grid {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .elvora-predictive-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .elvora-predictive-item:hover {
    background: rgba(212, 175, 55, 0.12);
    border-color: rgba(212, 175, 55, 0.4);
    transform: translateX(4px);
  }

  .elvora-predictive-thumb {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    overflow: hidden;
    background: #1C0C04;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .elvora-predictive-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .elvora-predictive-info {
    flex: 1;
    min-width: 0;
  }

  .elvora-predictive-type {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D4AF37;
    display: block;
    margin-bottom: 2px;
  }

  .elvora-predictive-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: #FFF6E8;
    margin: 0 0 2px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .elvora-predictive-price {
    font-size: 0.88rem;
    font-weight: 800;
    color: #FCD34D;
  }

  .elvora-predictive-footer {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .elvora-view-all-results-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #D4AF37;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }

  .elvora-view-all-results-btn:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .elvora-search-empty-state {
    text-align: center;
    padding: 2.5rem 1rem;
    color: rgba(255, 240, 220, 0.8);
  }

  .search-empty-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #FFF6E8;
    margin-bottom: 0.35rem;
  }

  .search-empty-sub {
    font-size: 0.82rem;
    color: rgba(255, 240, 220, 0.65);
    margin: 0;
  }

  .elvora-search-loading {
    text-align: center;
    padding: 2rem;
    color: #D4AF37;
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* ── Wishlist Modal Dialog & Card ── */
  .elvora-wishlist-dialog {
    max-width: 580px;
  }

  .elvora-wishlist-modal-card {
    background: linear-gradient(135deg, #1A0D06 0%, #2D160A 50%, #1A0D06 100%);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 25px rgba(212, 175, 55, 0.2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 85vh;
  }

  .elvora-wishlist-modal-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.22);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .elvora-wishlist-title-wrap {
