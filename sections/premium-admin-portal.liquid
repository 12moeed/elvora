  // Helper: Retrieve orders from localStorage or init default
  function getAdminOrders() {
    try {
      const stored = localStorage.getItem('elvora_admin_orders');
      if (stored) return JSON.parse(stored);
    } catch(e){}
    localStorage.setItem('elvora_admin_orders', JSON.stringify(DEFAULT_ADMIN_ORDERS));
    return DEFAULT_ADMIN_ORDERS;
  }

  // Helper: Retrieve products from localStorage or init default
  function getAdminProducts() {
    try {
      const stored = localStorage.getItem('elvora_admin_products');
      if (stored) return JSON.parse(stored);
    } catch(e){}
    localStorage.setItem('elvora_admin_products', JSON.stringify(DEFAULT_CATALOG_PRODUCTS));
    return DEFAULT_CATALOG_PRODUCTS;
  }

  // Helper: Retrieve registered customers from localStorage
  function getAdminCustomers() {
    let users = [];
    try {
      const stored = localStorage.getItem('elvora_registered_users');
      if (stored) users = JSON.parse(stored);
    } catch(e){}

    // Combine newly registered users with seed users
    const combined = [...users];
    SEED_CUSTOMERS.forEach(sc => {
      if (!combined.some(u => (u.email || '').toLowerCase() === sc.email.toLowerCase())) {
        combined.push(sc);
      }
    });
    return combined;
  }

  // Tab Switcher
  function switchAdminTab(tabId, btn) {
    document.querySelectorAll('.elvora-admin-pane').forEach(p => p.classList.remove('is-active'));
    document.querySelectorAll('.elvora-admin-tab-btn').forEach(b => b.classList.remove('is-active'));

    const targetPane = document.getElementById('admin-tab-' + tabId);
    if (targetPane) targetPane.classList.add('is-active');
    if (btn) btn.classList.add('is-active');

    if (tabId === 'orders') renderOrdersTable();
    if (tabId === 'products') renderProductsTable();
    if (tabId === 'customers') renderCustomersTable();
  }

  // Render Recent Orders on Dashboard
  function renderDashboardRecentOrders() {
    const tbody = document.getElementById('dashboard-recent-orders-body');
    if (!tbody) return;
    const orders = getAdminOrders().slice(0, 5);

    tbody.innerHTML = orders.map(ord => `
      <tr>
        <td><strong>#${ord.id}</strong></td>
        <td>
          <div style="font-weight: 600;">${escapeHtml(ord.customerName)}</div>
          <div style="font-size: 11px; color: #6b7280;">${ord.customerPhone}</div>
        </td>
        <td>${escapeHtml(ord.city)}</td>
        <td><strong>Rs. ${ord.total.toLocaleString()}</strong></td>
        <td><span class="elvora-status-badge ${ord.status.toLowerCase()}">${ord.status}</span></td>
      </tr>
    `).join('');
  }

  // Render Full Orders Table
  let currentStatusFilter = 'ALL';
  let currentSearchQuery = '';

  function renderOrdersTable() {
    const tbody = document.getElementById('orders-table-body');
    if (!tbody) return;
    const orders = getAdminOrders();

    const filtered = orders.filter(o => {
      const matchStatus = (currentStatusFilter === 'ALL') || (o.status === currentStatusFilter);
      const q = currentSearchQuery.toLowerCase();
      const matchSearch = !q || 
        o.id.toLowerCase().includes(q) || 
        o.customerName.toLowerCase().includes(q) || 
        o.city.toLowerCase().includes(q) || 
        o.customerPhone.includes(q);
      return matchStatus && matchSearch;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="9" style="text-align: center; padding: 2.5rem; color: #6b7280;">No orders found matching this filter.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(o => `
      <tr>
        <td><strong>#${o.id}</strong></td>
        <td style="font-size: 12px; color: #6b7280;">${o.date}</td>
        <td>
          <div style="font-weight: 600; color: #111827;">${escapeHtml(o.customerName)}</div>
          <div style="font-size: 11.5px; color: #4b5563;">${o.customerPhone}</div>
          <div style="font-size: 11px; color: #9ca3af;">${escapeHtml(o.customerEmail || '')}</div>
        </td>
        <td style="font-size: 12px;">
          <div><strong>${escapeHtml(o.city)}</strong></div>
          <div style="color: #6b7280; font-size: 11px; max-width: 180px;">${escapeHtml(o.address)}</div>
        </td>
        <td style="font-size: 12px; max-width: 200px;">${escapeHtml(o.items)}</td>
        <td><strong>Rs. ${o.total.toLocaleString()}</strong></td>
        <td><span class="elvora-badge-tag">${escapeHtml(o.payment)}</span></td>
        <td><span class="elvora-status-badge ${o.status.toLowerCase()}">${o.status}</span></td>
        <td>
          <select onchange="updateOrderStatus('${o.id}', this.value)" class="elvora-admin-select-status">
            <option value="PENDING" ${o.status === 'PENDING' ? 'selected' : ''}>Pending Verification</option>
            <option value="DISPATCHED" ${o.status === 'DISPATCHED' ? 'selected' : ''}>Dispatched via TCS/Trax</option>
            <option value="DELIVERED" ${o.status === 'DELIVERED' ? 'selected' : ''}>Delivered & Paid</option>
            <option value="CANCELLED" ${o.status === 'CANCELLED' ? 'selected' : ''}>Cancelled</option>
          </select>
        </td>
      </tr>
    `).join('');
  }

  function updateOrderStatus(orderId, newStatus) {
    const orders = getAdminOrders();
    const idx = orders.findIndex(o => o.id === orderId);
    if (idx !== -1) {
      orders[idx].status = newStatus;
      localStorage.setItem('elvora_admin_orders', JSON.stringify(orders));
      renderOrdersTable();
      renderDashboardRecentOrders();
      updateTopBadges();
      showAdminToast(`Order #${orderId} status updated to ${newStatus}`);
    }
  }

  function filterOrdersByStatus(status, btn) {
    currentStatusFilter = status;
    document.querySelectorAll('.elvora-status-pill').forEach(b => b.classList.remove('is-active'));
    if (btn) btn.classList.add('is-active');
    renderOrdersTable();
  }

  function filterOrdersTable(query) {
    currentSearchQuery = query;
    renderOrdersTable();
  }

  // Render Products Table
  function renderProductsTable() {
    const tbody = document.getElementById('products-table-body');
    if (!tbody) return;
    const products = getAdminProducts();

    tbody.innerHTML = products.map(p => `
      <tr>
        <td>
          <div style="font-weight: 700; color: #111827;">${escapeHtml(p.name)}</div>
          <div style="font-size: 11px; color: #9ca3af;">SKU: ELV-${p.id.toUpperCase()}</div>
        </td>
        <td><span class="elvora-badge-tag">${escapeHtml(p.category)}</span></td>
        <td style="font-size: 12px; color: #4b5563;">${escapeHtml(p.actives)}</td>
        <td><strong>Rs. ${p.price.toLocaleString()}</strong></td>
        <td>
          <span class="elvora-status-badge ${p.inStock ? 'delivered' : 'cancelled'}">
            ${p.inStock ? 'IN STOCK' : 'OUT OF STOCK'}
          </span>
        </td>
        <td>
          <button type="button" onclick="toggleProductStock('${p.id}')" class="elvora-admin-btn-action" style="padding: 4px 10px; font-size: 11.5px;">
            ${p.inStock ? 'Mark Out of Stock' : 'Mark In Stock'}
          </button>
        </td>
      </tr>
    `).join('');
  }

  function toggleProductStock(prodId) {
    const products = getAdminProducts();
    const prod = products.find(p => p.id === prodId);
    if (prod) {
      prod.inStock = !prod.inStock;
      localStorage.setItem('elvora_admin_products', JSON.stringify(products));
      renderProductsTable();
      showAdminToast(`${prod.name} is now ${prod.inStock ? 'In Stock' : 'Out of Stock'}`);
    }
  }

  function filterProductsTable(query) {
    const q = (query || '').toLowerCase().trim();
    const tbody = document.getElementById('products-table-body');
    if (!tbody) return;
    const products = getAdminProducts();
    const filtered = products.filter(p => !q || p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));

    tbody.innerHTML = filtered.map(p => `
      <tr>
        <td>
          <div style="font-weight: 700; color: #111827;">${escapeHtml(p.name)}</div>
          <div style="font-size: 11px; color: #9ca3af;">SKU: ELV-${p.id.toUpperCase()}</div>
        </td>
        <td><span class="elvora-badge-tag">${escapeHtml(p.category)}</span></td>
        <td style="font-size: 12px; color: #4b5563;">${escapeHtml(p.actives)}</td>
        <td><strong>Rs. ${p.price.toLocaleString()}</strong></td>
        <td>
          <span class="elvora-status-badge ${p.inStock ? 'delivered' : 'cancelled'}">
            ${p.inStock ? 'IN STOCK' : 'OUT OF STOCK'}
          </span>
        </td>
        <td>
          <button type="button" onclick="toggleProductStock('${p.id}')" class="elvora-admin-btn-action" style="padding: 4px 10px; font-size: 11.5px;">
            ${p.inStock ? 'Mark Out of Stock' : 'Mark In Stock'}
          </button>
        </td>
      </tr>
    `).join('');
  }

  // Render Customers Table
  function renderCustomersTable() {
    const tbody = document.getElementById('customers-table-body');
    if (!tbody) return;
    const customers = getAdminCustomers();

    tbody.innerHTML = customers.map(c => `
      <tr>
        <td><strong>#${c.id || 'ELV-U'}</strong></td>
        <td>
          <div style="font-weight: 700; color: #111827;">${escapeHtml(c.name || (c.firstName + ' ' + (c.lastName || '')))}</div>
        </td>
        <td style="font-size: 12.5px; color: #374151;">${escapeHtml(c.email)}</td>
        <td style="font-size: 12px; color: #4b5563;">${c.phone || '0300-1234567'}</td>
        <td>${escapeHtml(c.city || 'Lahore')}</td>
        <td><span class="elvora-badge-tag">${escapeHtml(c.tier || 'Private Circle VIP')}</span></td>
        <td style="font-size: 12px; color: #6b7280;">${c.registeredOn || c.createdAt || 'Nov 2026'}</td>
      </tr>
    `).join('');

    const countEl = document.getElementById('nav-customers-count');
    if (countEl) countEl.textContent = customers.length;
    const kpiCount = document.getElementById('kpi-customers-val');
    if (kpiCount) kpiCount.textContent = customers.length;
  }

  function filterCustomersTable(query) {
    const q = (query || '').toLowerCase().trim();
    const tbody = document.getElementById('customers-table-body');
    if (!tbody) return;
    const customers = getAdminCustomers();
    const filtered = customers.filter(c => {
      const name = (c.name || (c.firstName + ' ' + (c.lastName || ''))).toLowerCase();
      const email = (c.email || '').toLowerCase();
      const phone = c.phone || '';
      return !q || name.includes(q) || email.includes(q) || phone.includes(q);
    });

    tbody.innerHTML = filtered.map(c => `
      <tr>
        <td><strong>#${c.id || 'ELV-U'}</strong></td>
        <td>
          <div style="font-weight: 700; color: #111827;">${escapeHtml(c.name || (c.firstName + ' ' + (c.lastName || '')))}</div>
        </td>
        <td style="font-size: 12.5px; color: #374151;">${escapeHtml(c.email)}</td>
        <td style="font-size: 12px; color: #4b5563;">${c.phone || '0300-1234567'}</td>
        <td>${escapeHtml(c.city || 'Lahore')}</td>
        <td><span class="elvora-badge-tag">${escapeHtml(c.tier || 'Private Circle VIP')}</span></td>
        <td style="font-size: 12px; color: #6b7280;">${c.registeredOn || c.createdAt || 'Nov 2026'}</td>
      </tr>
    `).join('');
  }

  // Update Top Bar & KPI Badges
  function updateTopBadges() {
    const orders = getAdminOrders();
    const pending = orders.filter(o => o.status === 'PENDING').length;
    const topOrders = document.getElementById('top-orders-count');
    if (topOrders) topOrders.textContent = orders.length;
    const kpiOrders = document.getElementById('kpi-orders-count');
    if (kpiOrders) kpiOrders.textContent = orders.length;
    const pendingBadge = document.getElementById('nav-pending-badge');
    if (pendingBadge) pendingBadge.textContent = pending + ' New';
  }

  // Simulate new order
  function simulateNewOrder() {
    const randomNames = ["Sara Mansoor", "Ali Raza", "Mehwish Hayat", "Dr. Usman Farooq", "Hira Mani"];
    const randomCities = ["Lahore", "Karachi", "Islamabad", "Peshawar", "Multan"];
    const randomItems = [
      "10% Niacinamide Serum + SPF 50+ Sunscreen",
      "Vitamin C Radiance Elixir",
      "Ceramide Barrier Recovery Cream",
      "Gentle Rice Cleanser (x2)",
      "Hydrating Serum + Peptide Eye Elixir"
    ];
    const name = randomNames[Math.floor(Math.random() * randomNames.length)];
    const city = randomCities[Math.floor(Math.random() * randomCities.length)];
    const items = randomItems[Math.floor(Math.random() * randomItems.length)];
    const newId = "ELV-" + Math.floor(1050 + Math.random() * 400);

    const newOrder = {
      id: newId,
      date: "Just Now",
      customerName: name,
      customerPhone: "03" + Math.floor(10 + Math.random() * 89) + "-" + Math.floor(1000000 + Math.random() * 8999999),
      customerEmail: name.toLowerCase().replace(/\s+/g, '.') + "@gmail.com",
      city: city,
      address: "Sector B, Main Boulevard",
      items: items,
      total: Math.floor(2500 + Math.random() * 4000),
      payment: "Cash on Delivery",
      status: "PENDING"
    };

    const orders = getAdminOrders();
    orders.unshift(newOrder);
    localStorage.setItem('elvora_admin_orders', JSON.stringify(orders));

    renderOrdersTable();
    renderDashboardRecentOrders();
    updateTopBadges();
    showAdminToast(`✦ New order #${newId} received from ${name} (${city})!`);
  }

  // Reset Demo Data
  function resetAdminDemoData() {
    if (confirm("Reset all orders, products, and customer test data back to initial defaults?")) {
      localStorage.setItem('elvora_admin_orders', JSON.stringify(DEFAULT_ADMIN_ORDERS));
      localStorage.setItem('elvora_admin_products', JSON.stringify(DEFAULT_CATALOG_PRODUCTS));
      renderDashboardRecentOrders();
      renderOrdersTable();
      renderProductsTable();
      renderCustomersTable();
      updateTopBadges();
      showAdminToast("Admin demo data successfully restored to defaults.");
    }
  }

  // Admin Logout Handler
  function handleAdminLogout() {
    sessionStorage.removeItem('elvora_admin_logged_in');
    try {
      const u = JSON.parse(localStorage.getItem('elvora_auth_user') || '{}');
      if (u.role === 'admin') {
        localStorage.removeItem('elvora_auth_user');
      }
    } catch(e){}

    showAdminToast("Logging out of Admin Portal...");
    setTimeout(function() {
      window.location.href = '/pages/contact?view=login';
    }, 500);
  }

  // Toast Notification inside Admin
  function showAdminToast(msg) {
    let t = document.getElementById('elvora-admin-live-toast');
    if (!t) {
      t = document.createElement('div');
      t.id = 'elvora-admin-live-toast';
      t.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#111827;color:#fff;padding:12px 20px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 10px 25px rgba(0,0,0,0.3);z-index:999999;border:1px solid #d4af37;transition:all 0.3s ease;';
      document.body.appendChild(t);
    }
    t.textContent = msg;
    t.style.display = 'block';
    t.style.opacity = '1';
    clearTimeout(window._adminToastTimer);
    window._adminToastTimer = setTimeout(function() {
      t.style.opacity = '0';
      setTimeout(function() { t.style.display = 'none'; }, 300);
    }, 3200);
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, function(m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
    });
  }

  // Gatekeeper Authentication Verification
  (function verifyAdminAccess() {
    const gate = document.getElementById('elvora-admin-gatekeeper');
    const mainView = document.getElementById('elvora-admin-main-view');

    let isAdmin = false;
    try {
      const sessionLogged = sessionStorage.getItem('elvora_admin_logged_in') === 'true';
      const storedUser = JSON.parse(localStorage.getItem('elvora_auth_user') || '{}');
      if (sessionLogged || storedUser.role === 'admin' || (storedUser.email || '').toLowerCase() === 'admin@gmail.com') {
        isAdmin = true;
      }
    } catch(e){}

    if (!isAdmin) {
      if (gate) gate.style.display = 'flex';
      if (mainView) mainView.style.display = 'none';
      return;
    }

    // Authenticated
    if (gate) gate.style.display = 'none';
    if (mainView) mainView.style.display = 'block';

    // Clean browser URL bar
    if (window.location.search.includes('view=admin') && !window.location.pathname.includes('admin')) {
      try { window.history.replaceState({}, '', '/pages/admin'); } catch(e){}
    }

    // Initialize View
    renderDashboardRecentOrders();
    renderOrdersTable();
    renderProductsTable();
    renderCustomersTable();
    updateTopBadges();
  })();
</script>

