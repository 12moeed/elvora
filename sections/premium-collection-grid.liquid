<div class="premium-collection-main">
  <div class="premium-collection-container">
    {% paginate collection.products by section.settings.products_per_page %}
      <!-- Toolbar: Count + Sort -->
      <div class="premium-collection-toolbar">
        <div class="premium-collection-count">
          {% if collection.products_count > 0 %}
            Showing <span class="premium-highlight">{{ collection.products_count }}</span> products in <span class="premium-highlight">{{ collection.title }}</span>
          {% else %}
            Showing <span class="premium-highlight">10</span> products in <span class="premium-highlight">{{ collection.title | default: 'All Products' }}</span>
          {% endif %}
        </div>

        <div class="premium-collection-sort-wrap">
          <label for="premium-sort-by" class="premium-sort-label">Sort by:</label>
          <select id="premium-sort-by" class="premium-sort-select" onchange="location = this.value;">
            {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
            <option value="?sort_by=manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="?sort_by=best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="?sort_by=price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="?sort_by=price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="?sort_by=created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Date: New to Old</option>
          </select>
        </div>
      </div>

      <!-- Product Grid (5 columns on desktop) -->
      <div class="premium-product-grid">
        {% assign items_count = 0 %}
        {% for product in collection.products %}
          {% assign items_count = items_count | plus: 1 %}
          {% render 'premium-product-card', product: product %}
        {% endfor %}

        {% comment %} Fallback dummy cards if collection has no products {% endcomment %}
        {% if items_count == 0 %}
          {% render 'premium-product-card', dummy_title: 'Elegance Pump Heels', dummy_price: 'Rs. 8,999', dummy_compare_price: 'Rs. 12,000', dummy_category: 'Ladies Heels', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Urban Explorer Sneakers', dummy_price: 'Rs. 12,500', dummy_compare_price: 'Rs. 15,000', dummy_category: 'Gents Shoes', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Playful Paws Kids Shoes', dummy_price: 'Rs. 4,500', dummy_compare_price: 'Rs. 6,000', dummy_category: 'Kids Shoes', dummy_badge: 'SALE', dummy_image: 'https://images.unsplash.com/photo-1514989940723-e8875ea6f03f?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Chic Leather Tote Bag', dummy_price: 'Rs. 15,000', dummy_compare_price: 'Rs. 19,000', dummy_category: 'Luxury Bags', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Classic Chelsea Boot', dummy_price: 'Rs. 14,200', dummy_compare_price: 'Rs. 17,500', dummy_category: 'Footwear', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?auto=format&fit=crop&q=80&w=800' %}

          {% render 'premium-product-card', dummy_title: 'Rose Gold Chrono Watch', dummy_price: 'Rs. 19,500', dummy_compare_price: 'Rs. 23,000', dummy_category: 'Watches', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Signature Eau De Parfum', dummy_price: 'Rs. 8,900', dummy_compare_price: 'Rs. 11,500', dummy_category: 'Fragrances', dummy_badge: 'SALE', dummy_image: 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Minimalist Belted Handbag', dummy_price: 'Rs. 11,800', dummy_compare_price: 'Rs. 14,500', dummy_category: 'Bags', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Air Comfort Running Shoes', dummy_price: 'Rs. 10,500', dummy_compare_price: 'Rs. 13,000', dummy_category: 'Sneakers', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1584735935682-2f2b69dff9d2?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Strappy Block Heel Sandal', dummy_price: 'Rs. 7,800', dummy_compare_price: 'Rs. 10,000', dummy_category: 'Ladies Heels', dummy_badge: 'SALE', dummy_image: 'https://images.unsplash.com/photo-1535043934128-cf0b28d52f95?auto=format&fit=crop&q=80&w=800' %}
        {% endif %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <nav class="premium-pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="premium-page-link">← Previous</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="premium-page-link">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="premium-page-link active">{{ part.title }}</span>
              {% else %}
                <span class="premium-page-link">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="premium-page-link">Next →</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 10,
      "max": 30,
      "step": 5,
      "default": 15,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
