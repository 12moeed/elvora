          {% render 'premium-product-card', dummy_title: 'Gentle Oat Amino Foaming Cleanser', dummy_price: 'Rs. 2,600', dummy_compare_price: 'Rs. 3,500', dummy_category: 'Cleansers', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&q=80&w=800' %}
          
          {% render 'premium-product-card', dummy_title: 'Retinol 0.5% Night Cell Renewal Serum', dummy_price: 'Rs. 5,200', dummy_compare_price: 'Rs. 6,800', dummy_category: 'Night Care', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=800' %}
