{% comment %}
  ELVORA Skincare - Luxury Single Order Detail Template
  Functional Requirement: Order placement & tracking / Customer order history (Req 5 & 6)
{% endcomment %}

<div class="elvora-account-page-wrapper">
  <div class="elvora-account-container">
    
    <!-- Top Nav -->
    <div class="elvora-auth-top-nav">
      <a href="/account" class="elvora-auth-back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Return to Account Overview</span>
      </a>
    </div>

    <!-- Order Summary Banner -->
    <div class="elvora-account-hero-card">
      <div>
        <div class="elvora-account-tier-badge">
          <span class="elvora-tier-dot"></span>
          <span>Order Confirmed</span>
        </div>
        <h1 class="elvora-account-greeting">
          Order {{ order.name }}
        </h1>
        <p class="elvora-account-email">
          Placed on {{ order.created_at | date: "%B %d, %Y at %I:%M %p" }}
        </p>
      </div>

      <div class="elvora-account-header-actions">
        <a href="/pages/contact?view=track-order&order={{ order.name | replace: '#', '' }}" class="elvora-btn-acc-track">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
          </svg>
          <span>Track Delivery Status</span>
        </a>
      </div>
    </div>

    <!-- Order Content Grid -->
    <div class="elvora-account-content-grid">
      
      <!-- Left Column: Items Breakdown -->
      <div class="elvora-orders-section-card">
        <div class="elvora-orders-header">
          <div>
            <h2 class="elvora-orders-title">Formulations in This Order</h2>
            <p class="elvora-orders-sub">Laboratory prepared & clinical batch verified</p>
          </div>
          <div style="display: flex; gap: 8px;">
            {% if order.cancelled %}
              <span class="elvora-badge elvora-badge-error">Cancelled on {{ order.cancelled_at | date: "%B %d, %Y" }}</span>
            {% else %}
              {% if order.financial_status == 'paid' %}
                <span class="elvora-badge elvora-badge-paid">Paid</span>
              {% else %}
                <span class="elvora-badge elvora-badge-cod">Cash on Delivery</span>
              {% endif %}

              {% if order.fulfillment_status == 'fulfilled' %}
                <span class="elvora-badge elvora-badge-delivered">Fulfilled / Shipped</span>
              {% else %}
                <span class="elvora-badge elvora-badge-processing">Processing / In Lab QC</span>
              {% endif %}
            {% endif %}
          </div>
        </div>

        <!-- Table of Line Items -->
        <div class="elvora-orders-table-wrap">
          <table class="elvora-orders-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>SKU</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {% for line_item in order.line_items %}
                <tr>
                  <td>
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <div>
                        <strong style="color: #111827; font-size: 14px;">{{ line_item.title }}</strong>
                        {% if line_item.variant.title != 'Default Title' and line_item.variant.title != blank %}
                          <div style="color: #6b7280; font-size: 12px; margin-top: 2px;">Variant: {{ line_item.variant.title }}</div>
                        {% endif %}
                        {% if line_item.fulfillment %}
                          <div style="margin-top: 6px; font-size: 11px; color: #059669; font-weight: 600;">
                            Shipped via {{ line_item.fulfillment.tracking_company }}
                            {% if line_item.fulfillment.tracking_number %}
                              #{{ line_item.fulfillment.tracking_number }}
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </td>
                  <td style="color: #6b7280; font-size: 13px;">
                    {{ line_item.sku | default: 'ELV-SKU' }}
                  </td>
                  <td style="color: #374151; font-size: 14px;">
                    {{ line_item.price | money }}
                  </td>
                  <td style="color: #374151; font-size: 14px; font-weight: 600;">
                    × {{ line_item.quantity }}
                  </td>
                  <td style="color: #111827; font-size: 14px; font-weight: 700;">
                    {{ line_item.final_line_price | money }}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Order Financial Summary -->
        <div class="elvora-order-totals-box">
          <div class="elvora-order-totals-row">
            <span>Subtotal</span>
            <strong>{{ order.line_items_subtotal_price | money }}</strong>
          </div>
          {% for shipping_method in order.shipping_methods %}
            <div class="elvora-order-totals-row">
              <span>Shipping ({{ shipping_method.title }})</span>
              <strong>{{ shipping_method.price | money }}</strong>
            </div>
          {% endfor %}
          {% for tax_line in order.tax_lines %}
            <div class="elvora-order-totals-row">
              <span>Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
              <strong>{{ tax_line.price | money }}</strong>
            </div>
          {% endfor %}
          <div class="elvora-order-totals-row elvora-order-grand-total">
            <span>Grand Total (Payable via Cash on Delivery)</span>
            <strong style="color: #B34090;">{{ order.total_price | money_with_currency }}</strong>
          </div>
        </div>

      </div>

      <!-- Right Column: Shipping & Payment Details -->
      <div class="elvora-account-sidebar">
        
        <!-- Delivery Address -->
        <div class="elvora-profile-card">
          <div class="elvora-profile-card-header">
            <h3 class="elvora-profile-card-title">Delivery Address</h3>
            <span class="elvora-addr-badge">Cash on Delivery</span>
          </div>
          {% if order.shipping_address %}
            <div class="elvora-address-box">
              <div class="elvora-addr-name">
                {{ order.shipping_address.name }}
              </div>
              <p class="elvora-addr-lines">
                {{ order.shipping_address.street }}<br>
                {{ order.shipping_address.city }}, {{ order.shipping_address.province }} {{ order.shipping_address.zip }}<br>
                {{ order.shipping_address.country }}
              </p>
              {% if order.shipping_address.phone != blank %}
                <div class="elvora-addr-phone">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                  <span>{{ order.shipping_address.phone }}</span>
                </div>
              {% endif %}
            </div>
          {% else %}
            <p style="color: #6b7280; font-size: 13px;">No shipping address recorded.</p>
          {% endif %}
        </div>

        <!-- Payment Method Card -->
        <div class="elvora-profile-card">
          <div class="elvora-profile-card-header">
            <h3 class="elvora-profile-card-title">Payment Method</h3>
          </div>
          <div class="elvora-address-box">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
              <span style="font-size: 18px;">💵</span>
              <strong style="color: #111827; font-size: 14px;">Cash on Delivery (COD)</strong>
            </div>
            <p style="color: #4b5563; font-size: 13px; line-height: 1.5; margin: 0;">
              Payment of <strong>{{ order.total_price | money_with_currency }}</strong> will be collected in cash by the courier delivery rider upon package arrival.
            </p>
          </div>
        </div>

        <!-- Support Card -->
        <div class="elvora-concierge-card">
          <h4 class="elvora-concierge-title">Need Help with Order {{ order.name }}?</h4>
          <p class="elvora-concierge-desc">
            Our skincare customer care team is available to assist with address modifications, courier dispatch queries, or cancellations.
          </p>
          <a href="https://wa.me/923001234567?text=Hi%20ELVORA,%20I%20have%20a%20question%20about%20Order%20{{ order.name }}" target="_blank" rel="noopener" class="elvora-btn-whatsapp-support">
            <span>WhatsApp Order Support</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</div>
