    font-size: 1.35rem;
    font-weight: 700;
    color: #FFF6E8;
    margin: 0;
    line-height: 1.2;
  }

  .elvora-wishlist-modal-sub {
    font-size: 0.76rem;
    color: rgba(255, 240, 220, 0.65);
    margin: 2px 0 0;
  }

  .elvora-wishlist-counter-tag {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
