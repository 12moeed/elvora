          {% render 'premium-product-card', dummy_title: 'Invisible Daily Glow Sunscreen SPF 50+', dummy_price: 'Rs. 3,200', dummy_compare_price: 'Rs. 4,200', dummy_category: 'Sun Protection', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&q=80&w=800' %}
