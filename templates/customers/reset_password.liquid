{% comment %}
  ELVORA Skincare - Reset Password Template
{% endcomment %}

<div class="elvora-auth-page-wrapper">
  <div class="elvora-auth-container" style="max-width: 540px;">
    
    <div class="elvora-auth-form-card" style="width: 100%;">
      <div class="elvora-auth-header">
        <span class="elvora-auth-kicker">Security Update</span>
        <h1 class="elvora-auth-title">Reset Your Password</h1>
        <p class="elvora-auth-subtitle">
          Please enter a new password for your ELVORA account.
        </p>
      </div>

      {% form 'reset_customer_password', class: 'elvora-auth-form' %}
        {% if form.errors %}
          <div class="elvora-auth-alert elvora-auth-alert-error" role="alert">
            <span>{{ form.errors | default_errors }}</span>
          </div>
        {% endif %}

        <div class="elvora-form-field">
          <label for="ResetPassword" class="elvora-form-label">New Password *</label>
          <input type="password" name="customer[password]" id="ResetPassword" class="elvora-form-input" required minlength="6" placeholder="••••••••">
        </div>

        <div class="elvora-form-field">
          <label for="ResetPasswordConfirm" class="elvora-form-label">Confirm New Password *</label>
          <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" class="elvora-form-input" required minlength="6" placeholder="••••••••">
        </div>

        <div class="elvora-auth-actions">
          <button type="submit" class="elvora-btn-auth-primary">
            <span>Update Password</span>
          </button>
        </div>
      {% endform %}
    </div>

  </div>
</div>

