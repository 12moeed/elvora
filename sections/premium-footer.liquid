<footer class="premium-footer">
  <div class="premium-gradient-line" style="position: absolute; top: 0; left: 0; right: 0;"></div>

  <div class="premium-footer-grid">
    <!-- Col 1: Brand Info -->
    <div>
      <h3 class="premium-footer-brand-title">{{ section.settings.brand_name | default: 'ELVORA' }}</h3>
      <div class="premium-footer-brand-sub">{{ section.settings.brand_subtitle | default: 'COLLECTION' }}</div>
      <p class="premium-footer-desc">
        {{ section.settings.brand_desc | default: 'Discover timeless footwear, luxury bags, and handcrafted accessories engineered with premium craftsmanship for everyday distinction.' }}
      </p>

      <div style="display: flex; gap: 12px; margin-top: 1rem;">
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #222222; color: #ffffff;">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </span>
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #222222; color: #ffffff;">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </span>
      </div>
    </div>

    <!-- Col 2: Navigation Links -->
    <div>
      <h4 class="premium-footer-heading">{{ section.settings.col2_title | default: 'Quick Shop' }}</h4>
      <ul class="premium-footer-links">
        <li><a href="/collections/all">Shop All Products</a></li>
        <li><a href="/collections/all">Ladies Footwear</a></li>
        <li><a href="/collections/all">Gents Footwear</a></li>
        <li><a href="/collections/all">Handbags & Clutches</a></li>
        <li><a href="/collections/all">Signature Perfumes</a></li>
      </ul>
    </div>

    <!-- Col 3: Customer Service -->
    <div>
      <h4 class="premium-footer-heading">{{ section.settings.col3_title | default: 'Customer Care' }}</h4>
      <ul class="premium-footer-links">
        <li><a href="/pages/contact">Contact Support</a></li>
        <li><a href="/pages/about">Our Story</a></li>
        <li><a href="/pages/shipping">Track Your Order</a></li>
        <li><a href="/pages/refund-policy">Easy 7-Day Returns</a></li>
        <li><a href="/pages/privacy-policy">Privacy & Security</a></li>
      </ul>
    </div>

    <!-- Col 4: Newsletter Subscription -->
    <div>
      <h4 class="premium-footer-heading">{{ section.settings.col4_title | default: 'Stay Connected' }}</h4>
      <p style="color: #9ca3af; font-size: 13px; line-height: 1.6; margin-bottom: 1rem;">
        Subscribe for secret drops, VIP discounts, and seasonal updates.
      </p>

      {% form 'customer', class: 'premium-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="premium-newsletter-input"
          placeholder="Enter your email"
          required
        >
        <button type="submit" class="premium-newsletter-btn">JOIN</button>
      {% endform %}

      <div style="margin-top: 1.5rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span style="font-size: 10px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.1em; width: 100%;">We Accept:</span>
        <span style="background: #1f2937; color: #10b981; font-weight: 700; font-size: 10px; padding: 4px 8px; border-radius: 6px;">Cash on Delivery</span>
        <span style="background: #1f2937; color: #60a5fa; font-weight: 700; font-size: 10px; padding: 4px 8px; border-radius: 6px;">Visa / Mastercard</span>
        <span style="background: #1f2937; color: #f87171; font-weight: 700; font-size: 10px; padding: 4px 8px; border-radius: 6px;">JazzCash</span>
        <span style="background: #1f2937; color: #34d399; font-weight: 700; font-size: 10px; padding: 4px 8px; border-radius: 6px;">Easypaisa</span>
      </div>
    </div>
  </div>

  <div class="premium-footer-bottom">
    <div style="max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'ELVORA' }} • ALL RIGHTS RESERVED</span>
      <span>POWERED BY SHOPIFY</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Premium Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "ELVORA"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand Subtitle",
      "default": "COLLECTION"
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand Description",
      "default": "Discover timeless footwear, luxury bags, and handcrafted accessories engineered with premium craftsmanship for everyday distinction."
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 Title",
      "default": "Quick Shop"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 Title",
      "default": "Customer Care"
    },
    {
      "type": "text",
      "id": "col4_title",
      "label": "Column 4 Title",
      "default": "Stay Connected"
    }
  ],
  "presets": [
    {
      "name": "Premium Footer"
    }
  ]
}
{% endschema %}
