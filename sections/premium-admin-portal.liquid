<div class="elvora-admin-wrapper" id="elvora-admin-app">
  
  <!-- Access Denied Screen (Shown if not authenticated as Admin) -->
  <div id="elvora-admin-gatekeeper" class="elvora-admin-gate" style="display: none;">
    <div class="elvora-gate-card">
      <div class="elvora-gate-icon">🔒</div>
      <h2 class="elvora-gate-title">Administrator Authentication Required</h2>
      <p class="elvora-gate-desc">
        This area is restricted to authorized ELVORA Skincare store administrators. Please sign in with your administrative credentials to continue.
      </p>
      <div class="elvora-gate-hint">
        <strong>Demo Admin Credentials:</strong><br>
        Email: <code>admin@gmail.com</code> &bull; Password: <code>admin12345</code>
      </div>
      <div class="elvora-gate-actions">
        <a href="/pages/contact?view=login" class="elvora-admin-btn-primary">
          <span>Go to Administrator Sign In</span>
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/" class="elvora-admin-btn-secondary">Return to Storefront</a>
