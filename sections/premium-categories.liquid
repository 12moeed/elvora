<div class="premium-categories-wrapper">
  <div class="premium-section-header">
    <div>
      <span class="premium-eyebrow">
        <span class="premium-eyebrow-dot"></span>
        {{ section.settings.eyebrow | default: 'Targeted Care' }}
      </span>
      <h2 class="premium-section-title">
        {{ section.settings.title | default: 'Shop by Skincare Category' }}
        <span class="premium-section-title-line"></span>
      </h2>
    </div>

    {% if section.settings.show_view_all %}
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="premium-view-all-btn">
        View All
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    {% endif %}
  </div>

  {% if section.settings.layout == 'accordion' %}
    <!-- Horizontal Accordion (No Shade) -->
    <div class="category-accordion-container horizontal-accordion">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: '/collections/all' }}"
          class="category-accordion-item clean-no-shade"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.title | escape }}"
              class="category-accordion-img"
              loading="lazy"
              width="900"
              height="600"
            >
          {% elsif block.settings.image_url != blank %}
            <img
              src="{{ block.settings.image_url }}"
              alt="{{ block.settings.title | escape }}"
              class="category-accordion-img"
              loading="lazy"
              width="900"
              height="600"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=900"
              alt="{{ block.settings.title | escape }}"
              class="category-accordion-img"
              loading="lazy"
              width="900"
              height="600"
            >
          {% endif %}

          <div class="premium-cat-glass-pill">
            <div class="premium-cat-pill-text">
              <h3 class="premium-cat-pill-title">{{ block.settings.title }}</h3>
              <span class="premium-cat-pill-count">{{ block.settings.subtitle | default: 'Explore' }}</span>
            </div>
            <span class="premium-cat-pill-arrow">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>

  {% else %}
    <!-- 5-Column Clean Horizontal Cards Grid (No Shade) -->
    <div class="premium-horizontal-cat-grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: '/collections/all' }}"
          class="premium-horizontal-cat-card"
          {{ block.shopify_attributes }}
        >
          <div class="premium-horizontal-cat-media">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title | escape }}"
                class="premium-horizontal-cat-img"
                loading="lazy"
                width="800"
                height="500"
              >
            {% elsif block.settings.image_url != blank %}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.title | escape }}"
                class="premium-horizontal-cat-img"
                loading="lazy"
                width="800"
                height="500"
              >
            {% else %}
              <img
                src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=800"
                alt="{{ block.settings.title | escape }}"
                class="premium-horizontal-cat-img"
                loading="lazy"
                width="800"
                height="500"
              >
            {% endif %}
          </div>

          <!-- Clean Floating Bottom Glass Pill (NO SHADE) -->
          <div class="premium-cat-glass-pill">
            <div class="premium-cat-pill-text">
              <h3 class="premium-cat-pill-title">{{ block.settings.title }}</h3>
              <span class="premium-cat-pill-count">{{ block.settings.subtitle | default: 'Explore' }}</span>
            </div>
            <span class="premium-cat-pill-arrow">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Premium Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Targeted Care"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Shop by Skincare Category"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Card Layout Style",
      "options": [
        { "value": "grid", "label": "Horizontal Cards (5 Columns)" },
        { "value": "accordion", "label": "Horizontal Accordion" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Serums & Actives"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "32 Formulas"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (Fallback)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Categories",
      "blocks": [
        {
