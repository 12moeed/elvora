<footer class="premium-footer">
  <div class="premium-gradient-line" style="position: absolute; top: 0; left: 0; right: 0;"></div>

  <div class="premium-footer-grid">
    <!-- Col 1: About Us (Matching Reference Screenshot & ELVORA Brand) -->
    <div class="premium-footer-col">
      <h3 class="premium-footer-brand-title">{{ section.settings.brand_name | default: 'ELVORA' }}</h3>
      <div class="premium-footer-brand-sub">{{ section.settings.brand_subtitle | default: 'CLINICAL SKINCARE' }}</div>
      <p class="premium-footer-desc">
        {{ section.settings.brand_desc | default: 'Science-backed clinical formulations, dermatologist-developed serums, and barrier repair treatments crafted for healthy, radiant skin across Pakistan.' }}
      </p>

      <div class="premium-footer-locations">
        <div class="premium-footer-loc-item">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>DHA Phase 5, Lahore, Pakistan</span>
        </div>
        <div class="premium-footer-loc-item">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Clifton Block 4, Karachi, Pakistan</span>
        </div>
        <div class="premium-footer-loc-item">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
          <span>In Technical Lab Collaboration with Swiss & Korean Dermatology Labs</span>
        </div>
      </div>
    </div>

    <!-- Col 2: Contact Details -->
    <div class="premium-footer-col">
      <h4 class="premium-footer-heading">{{ section.settings.col2_title | default: 'Contact' }}</h4>
      <div class="premium-footer-contact-list">
        <div class="premium-footer-contact-entry">
          <div class="premium-footer-contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <a href="tel:042111000990" class="premium-footer-contact-val">042-111-000-990</a>
            <span class="premium-footer-contact-label">(Customer Support Call)</span>
          </div>
        </div>

        <div class="premium-footer-contact-entry">
          <div class="premium-footer-contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <div>
            <a href="https://wa.me/923001234567" target="_blank" class="premium-footer-contact-val">0300-1234567</a>
            <span class="premium-footer-contact-label">(WhatsApp • Mon-Sat 10AM to 10PM)</span>
          </div>
        </div>

        <div class="premium-footer-contact-entry">
          <div class="premium-footer-contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <a href="mailto:support@elvora.pk" class="premium-footer-contact-val">support@elvora.pk</a>
            <span class="premium-footer-contact-label">(Official Care Helpdesk)</span>
          </div>
        </div>

        <div class="premium-footer-contact-entry">
          <div class="premium-footer-contact-icon">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <div>
            <a href="/pages/contact?view=track-order" class="premium-footer-contact-val">Track Your Order</a>
            <span class="premium-footer-contact-label">(Live Courier Tracking)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Col 3: Shop Categories -->
    <div class="premium-footer-col">
      <h4 class="premium-footer-heading">{{ section.settings.col3_title | default: 'Shop' }}</h4>
      <ul class="premium-footer-links">
        <li><a href="/collections/all">Best Selling Formulations</a></li>
        <li><a href="/collections/all">Niacinamide & Vitamin C Serums</a></li>
        <li><a href="/collections/all">Clinical Cleansers & Toners</a></li>
        <li><a href="/collections/all">Sun Protection SPF 50+</a></li>
        <li><a href="/collections/all">Barrier Repair Moisturizers</a></li>
        <li><a href="/collections/all">All Clinical Products</a></li>
      </ul>
    </div>

    <!-- Col 4: Helpful Links (Supervisor's Exact Requirements) -->
    <div class="premium-footer-col">
      <h4 class="premium-footer-heading">{{ section.settings.col4_title | default: 'Helpful Links' }}</h4>
      <ul class="premium-footer-links">
        <li><a href="/pages/contact?view=shipping-policy">Shipping Policy</a></li>
        <li><a href="/pages/contact?view=privacy-policy">Privacy Policy</a></li>
        <li><a href="/pages/contact?view=return-and-refund-policy">Return and Refund Policy</a></li>
        <li><a href="/pages/contact?view=terms-and-conditions">Terms and Conditions</a></li>
        <li><a href="/pages/contact">Contact Us</a></li>
        <li><a href="/pages/contact?view=faq">FAQ (Frequently Asked Questions)</a></li>
      </ul>
    </div>
  </div>

  <!-- Middle Banner: Newsletter Subscription & Accepted Payment Methods -->
  <div class="premium-footer-newsletter-wrap">
    <div class="premium-footer-newsletter-inner">
      <div class="premium-footer-newsletter-text">
        <h4 style="font-size: 14px; font-weight: 700; color: #ffffff; letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 4px;">
          Join the ELVORA Private Circle
        </h4>
        <p style="font-size: 12px; color: #a39587; margin: 0;">
          Receive clinical skincare recommendations, early access to new formulations & exclusive discounts.
        </p>
      </div>

      <div class="premium-footer-newsletter-action">
        {% form 'customer', class: 'premium-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="premium-newsletter-input"
            placeholder="Enter your email address"
            required
          >
          <button type="submit" class="premium-newsletter-btn">SUBSCRIBE</button>
        {% endform %}
      </div>

      <div class="premium-footer-payments-bar">
        <span class="premium-payments-label">We Accept:</span>
        <span class="premium-pay-pill pay-cod">Cash on Delivery</span>
        <span class="premium-pay-pill pay-card">Visa / Mastercard</span>
        <span class="premium-pay-pill pay-jazz">JazzCash</span>
        <span class="premium-pay-pill pay-easy">Easypaisa</span>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Social Links & Copyright -->
  <div class="premium-footer-bottom">
    <div class="premium-footer-bottom-inner">
      
      <!-- Follow Us Social Links -->
      <div class="premium-footer-social">
        <span class="premium-social-label">Follow Us</span>
        
        <!-- Facebook -->
        <a href="https://facebook.com" target="_blank" rel="noopener" class="premium-social-icon" aria-label="Facebook">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a href="https://instagram.com" target="_blank" rel="noopener" class="premium-social-icon" aria-label="Instagram">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a href="https://youtube.com" target="_blank" rel="noopener" class="premium-social-icon" aria-label="YouTube">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>

        <!-- TikTok -->
        <a href="https://tiktok.com" target="_blank" rel="noopener" class="premium-social-icon" aria-label="TikTok">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
      </div>

      <!-- Copyright Notice -->
      <div class="premium-footer-copy">
        <span>© Copyright, {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'ELVORA' }} Clinical Skincare</span>
        <span class="premium-dot-sep">•</span>
        <span>All Rights Reserved</span>
      </div>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Premium Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "ELVORA"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand Subtitle",
      "default": "CLINICAL SKINCARE"
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand Description",
      "default": "Science-backed clinical formulations, dermatologist-developed serums, and barrier repair treatments crafted for healthy, radiant skin across Pakistan."
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 Title",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 Title",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "col4_title",
      "label": "Column 4 Title",
      "default": "Helpful Links"
    }
  ],
  "presets": [
    {
      "name": "Premium Footer"
    }
  ]
}
{% endschema %}
