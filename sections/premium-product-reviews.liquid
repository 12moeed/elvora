        <div class="elvora-rc-header">
          <div class="elvora-rc-avatar">SF</div>
          <div class="elvora-rc-author-info">
            <div class="elvora-rc-name-row">
              <strong class="elvora-rc-name">Dr. Sara Fatima</strong>
              <span class="elvora-verified-tag">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
