    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wishlist-empty-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: #FFF6E8;
    margin: 0 0 0.35rem;
  }

  .wishlist-empty-text {
    font-size: 0.82rem;
    color: rgba(255, 240, 220, 0.65);
    max-width: 360px;
    margin: 0 auto 1.25rem;
    line-height: 1.45;
  }

  /* ── Global Floating Toast Notification ── */
  .elvora-global-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    z-index: 999999;
    pointer-events: none;
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  .elvora-global-toast.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .elvora-toast-content {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0.85rem 1.45rem;
    background: linear-gradient(135deg, rgba(28, 14, 7, 0.96) 0%, rgba(45, 22, 10, 0.98) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.7);
    border-radius: 9999px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.3);
    color: #FFF6E8;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script>
  (function initElvoraNavbar() {
    const headerRoot = document.getElementById('header-component');
    if (!headerRoot) return;

    const isHome = headerRoot.dataset.isHome === 'true';
    const isAuth = headerRoot.dataset.isAuth === 'true';
    const transparentEnabled = headerRoot.dataset.transparent === 'true';

    // ── 1. Scroll State Management (Scrubbed smoothly) ──
    function handleScroll() {
      if (isAuth) {
        headerRoot.classList.add('elvora-is-transparent');
        headerRoot.classList.remove('elvora-is-scrolled');
        headerRoot.setAttribute('transparent', 'not-sticky');
        return;
      }

      if (!isHome || !transparentEnabled) {
        headerRoot.classList.remove('elvora-is-transparent');
        headerRoot.classList.add('elvora-is-scrolled');
        return;
      }

      // Transition smoothly by 50px of scroll
      if (window.scrollY > 40) {
        headerRoot.classList.remove('elvora-is-transparent');
        headerRoot.classList.add('elvora-is-scrolled');
        headerRoot.removeAttribute('transparent');
      } else {
        headerRoot.classList.add('elvora-is-transparent');
        headerRoot.classList.remove('elvora-is-scrolled');
        headerRoot.setAttribute('transparent', 'not-sticky');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // ── 2. Interactive Search Modal ──
    const searchModal = document.getElementById('elvora-search-modal');
    const searchInput = document.getElementById('elvora-search-input');
    const searchTrigger = document.getElementById('elvora-search-trigger');
    const mobileSearchTrigger = document.getElementById('elvora-mobile-search-trigger');
    const searchCloseBtn = document.getElementById('elvora-search-close-btn');

    function openSearch() {
      if (!searchModal) return;
      searchModal.classList.add('is-open');
      searchModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput && searchInput.focus(), 150);
    }

    function closeSearch() {
      if (!searchModal) return;
      searchModal.classList.remove('is-open');
      searchModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (searchTrigger) searchTrigger.addEventListener('click', openSearch);
    if (mobileSearchTrigger) mobileSearchTrigger.addEventListener('click', openSearch);
    if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearch);

    // Close on backdrop click
    if (searchModal) {
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearch();
      });
    }

    // ⌘K or Ctrl+K shortcut
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (searchModal && searchModal.classList.contains('is-open')) {
          closeSearch();
        } else {
          openSearch();
        }
      }
      if (e.key === 'Escape' && searchModal && searchModal.classList.contains('is-open')) {
        closeSearch();
      }
    });

    // ── 3. Mobile Navigation Drawer ──
    const drawerBackdrop = document.getElementById('elvora-mobile-drawer');
    const menuTrigger = document.getElementById('elvora-mobile-menu-trigger');
    const drawerCloseBtn = document.getElementById('elvora-drawer-close');
    const shopToggle = document.getElementById('elvora-drawer-shop-toggle');
    const shopAccordion = shopToggle ? shopToggle.closest('.elvora-drawer-accordion') : null;

    function openDrawer() {
      if (!drawerBackdrop) return;
      drawerBackdrop.classList.add('is-open');
      drawerBackdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawerBackdrop) return;
      drawerBackdrop.classList.remove('is-open');
      drawerBackdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (menuTrigger) menuTrigger.addEventListener('click', openDrawer);
    if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);

    if (drawerBackdrop) {
      drawerBackdrop.addEventListener('click', (e) => {
        if (e.target === drawerBackdrop) closeDrawer();
      });
    }

    if (shopToggle && shopAccordion) {
      shopToggle.addEventListener('click', () => {
        shopAccordion.classList.toggle('is-open');
      });
    }

    // ── 4. Live Predictive Search Engine ──
    const searchForm = document.getElementById('elvora-search-form');
    const predictiveWrap = document.getElementById('elvora-predictive-results');
    const searchDefaultContent = document.getElementById('elvora-search-default-content');
    let searchDebounceTimer = null;

    function renderPredictiveResults(products, term) {
      if (!predictiveWrap) return;
      if (!products || products.length === 0) {
        predictiveWrap.innerHTML = `
          <div class="elvora-predictive-empty" style="text-align: center; padding: 2rem 1rem;">
            <svg width="34" height="34" fill="none" stroke="rgba(212, 175, 55, 0.6)" stroke-width="1.5" viewBox="0 0 24 24" style="margin: 0 auto 0.5rem; display: block;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <p style="font-size: 0.95rem; font-weight: 700; color: #FFF6E8; margin: 0 0 4px;">No products found for "${term}"</p>
            <p style="font-size: 0.8rem; color: rgba(255, 240, 220, 0.65); margin: 0;">Try searching for "Niacinamide", "Vitamin C", "Sunscreen", or "Ceramide".</p>
          </div>
        `;
        predictiveWrap.style.display = 'block';
        if (searchDefaultContent) searchDefaultContent.style.display = 'none';
        return;
      }

      let html = '<div class="elvora-predictive-grid">';
      products.forEach(p => {
        const imageSrc = p.image || p.featured_image || '';
        let displayPrice = '';
        if (p.price) {
          const numPrice = typeof p.price === 'number' ? Math.round(p.price / (p.price > 10000 ? 100 : 1)) : p.price;
          displayPrice = 'Rs. ' + Number(numPrice).toLocaleString();
        } else {
          displayPrice = 'Rs. 3,450';
        }

        html += `
          <a href="${p.url}" class="elvora-predictive-item">
            <div class="elvora-predictive-thumb">
              ${imageSrc ? `<img src="${imageSrc}" alt="${p.title}" loading="lazy">` : `<span style="color:#D4AF37; font-size:1.2rem;">✦</span>`}
            </div>
            <div class="elvora-predictive-info" style="flex: 1; min-width: 0;">
              <div class="elvora-predictive-title" style="font-size: 0.92rem; font-weight: 700; color: #FFF6E8; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.title}</div>
              <div class="elvora-predictive-price" style="font-size: 0.85rem; font-weight: 800; color: #FCD34D;">${displayPrice}</div>
            </div>
            <span class="elvora-predictive-arrow" style="color: rgba(212, 175, 55, 0.7); display: flex; align-items: center;">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        `;
      });
      html += '</div>';

      html += `
        <div style="margin-top: 1rem; text-align: center; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 0.75rem;">
          <a href="/search?type=product&options[prefix]=last&q=${encodeURIComponent(term)}" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: #D4AF37; text-decoration: none;">
            <span>View All Search Results for "${term}"</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      `;

      predictiveWrap.innerHTML = html;
      predictiveWrap.style.display = 'block';
      if (searchDefaultContent) searchDefaultContent.style.display = 'none';
    }

    function doPredictiveSearch(query) {
      const trimmed = (query || '').trim();
      if (trimmed.length < 2) {
        if (predictiveWrap) {
          predictiveWrap.innerHTML = '';
          predictiveWrap.style.display = 'none';
        }
        if (searchDefaultContent) searchDefaultContent.style.display = 'block';
        return;
      }

      fetch(`/search/suggest.json?q=${encodeURIComponent(trimmed)}&resources[type]=product&resources[options][unavailable_products]=show`)
        .then(res => res.json())
        .then(data => {
          const products = (data && data.resources && data.resources.results && data.resources.results.products) || [];
          renderPredictiveResults(products, trimmed);
        })
        .catch(err => {
          console.warn('Predictive search error:', err);
        });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
          doPredictiveSearch(e.target.value);
        }, 220);
      });
    }

    const drawerSearchInput = document.getElementById('elvora-drawer-search-input');
    if (drawerSearchInput) {
      drawerSearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const q = drawerSearchInput.value.trim();
          if (q) window.location.href = `/search?type=product&options[prefix]=last&q=${encodeURIComponent(q)}`;
        }
      });
    }

    // ── 5. Wishlist Modal & LocalStorage Manager ──
    const wishlistModal = document.getElementById('elvora-wishlist-modal');
    const wishlistTrigger = document.getElementById('elvora-wishlist-trigger');
    const drawerWishlistTrigger = document.getElementById('elvora-drawer-wishlist-btn');
    const wishlistCloseBtn = document.getElementById('elvora-wishlist-close-btn');
    const wishlistModalBody = document.getElementById('elvora-wishlist-modal-body');
    const wishlistModalCount = document.getElementById('elvora-wishlist-modal-count');

    function getWishlist() {
      try {
        return JSON.parse(localStorage.getItem('elvora_wishlist') || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveWishlist(list) {
      try {
        localStorage.setItem('elvora_wishlist', JSON.stringify(list));
      } catch (e) {}
      window.syncWishlistBadges();
    }

    window.syncWishlistBadges = function() {
      const list = getWishlist();
      const count = list.length;
      const desktopBadge = document.getElementById('elvora-wishlist-badge');
      const drawerBadge = document.getElementById('elvora-drawer-wishlist-badge');
      if (desktopBadge) {
        desktopBadge.textContent = count;
        desktopBadge.style.display = count > 0 ? 'flex' : 'none';
      }
      if (drawerBadge) {
        drawerBadge.textContent = count;
        drawerBadge.style.display = count > 0 ? 'inline-block' : 'none';
      }
      if (wishlistModalCount) {
        wishlistModalCount.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
      }

      // Update heart button active states on all visible cards
      document.querySelectorAll('.elvora-card-heart-btn, .elvora-wishlist-btn-card').forEach(btn => {
        const id = btn.getAttribute('data-variant-id') || btn.getAttribute('data-product-id');
        const isSaved = list.some(item => item.variantId === id || item.id === id);
        if (isSaved) {
          btn.classList.add('is-active');
        } else {
          btn.classList.remove('is-active');
        }
      });
    };

    window.openWishlistModal = function() {
      if (!wishlistModal) return;
      window.renderElvoraWishlistModal();
      wishlistModal.classList.add('is-open');
      wishlistModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    window.closeWishlistModal = function() {
      if (!wishlistModal) return;
      wishlistModal.classList.remove('is-open');
      wishlistModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    if (wishlistTrigger) wishlistTrigger.addEventListener('click', window.openWishlistModal);
    if (drawerWishlistTrigger) {
      drawerWishlistTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        closeDrawer();
        setTimeout(window.openWishlistModal, 200);
      });
    }
    if (wishlistCloseBtn) wishlistCloseBtn.addEventListener('click', window.closeWishlistModal);
    if (wishlistModal) {
      wishlistModal.addEventListener('click', (e) => {
        if (e.target === wishlistModal) window.closeWishlistModal();
      });
    }

    window.renderElvoraWishlistModal = function() {
      if (!wishlistModalBody) return;
      const list = getWishlist();
      window.syncWishlistBadges();

      if (list.length === 0) {
        wishlistModalBody.innerHTML = `
          <div class="elvora-wishlist-empty">
            <div class="elvora-wishlist-empty-icon">
              <svg width="28" height="28" fill="none" stroke="#D4AF37" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <h3 class="wishlist-empty-heading">Your Wishlist is Empty</h3>
            <p class="wishlist-empty-text">Tap the heart icon on any clinical formulation to save it to your personal wishlist.</p>
            <a href="/collections/all" class="elvora-empty-action-btn" onclick="window.closeWishlistModal()" style="display: inline-flex; align-items: center; gap: 8px; padding: 0.65rem 1.4rem; border-radius: 9999px; background: linear-gradient(135deg, #46240E 0%, #784119 50%, #C48739 100%); color: #ffffff; text-decoration: none; font-size: 0.82rem; font-weight: 700; border: 1.5px solid rgba(229,195,122,0.6);">
              <span>Explore Clinical Collection</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        `;
        return;
      }

      let html = '<div class="elvora-wishlist-items-list">';
      list.forEach((item, index) => {
        const image = item.image || '';
        const price = item.price || 'Rs. 3,450';
        html += `
          <div class="elvora-wishlist-item" data-index="${index}">
            <a href="${item.url || '#'}" class="elvora-wishlist-thumb">
              ${image ? `<img src="${image}" alt="${item.title}" loading="lazy">` : `<span style="color:#D4AF37;">✦</span>`}
            </a>
            <div class="elvora-wishlist-details">
              <h4 class="elvora-wishlist-item-title">
                <a href="${item.url || '#'}">${item.title}</a>
              </h4>
              <span class="elvora-wishlist-item-price">${price}</span>
              <div class="elvora-wishlist-actions">
                <button
                  type="button"
                  class="elvora-wishlist-add-cart-btn"
                  onclick="window.addWishlistItemToCart('${item.variantId}', '${encodeURIComponent(item.title)}', this)"
                >
                  Add to Cart
                </button>
                <a
                  href="/cart/${item.variantId}:1"
                  class="elvora-wishlist-buy-btn"
                  title="Direct Instant Checkout"
                >
                  Buy Now
                </a>
              </div>
            </div>
            <button
              type="button"
              class="elvora-wishlist-remove-btn"
              onclick="window.removeWishlistItemByIndex(${index})"
              title="Remove from favorites"
              aria-label="Remove item"
            >
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        `;
      });
      html += '</div>';

      html += `
        <div class="elvora-wishlist-footer">
          <button type="button" class="elvora-wishlist-clear-btn" onclick="window.clearAllElvoraWishlist()">
            Clear All Saved Items
          </button>
        </div>
      `;

      wishlistModalBody.innerHTML = html;
    };

    window.removeWishlistItemByIndex = function(idx) {
      const list = getWishlist();
      if (idx >= 0 && idx < list.length) {
        const removed = list.splice(idx, 1);
        saveWishlist(list);
        window.renderElvoraWishlistModal();
        if (removed[0]) {
          window.showElvoraToast(`Removed ${removed[0].title} from favorites`);
        }
      }
    };

    window.clearAllElvoraWishlist = function() {
      if (confirm('Are you sure you want to clear your saved rituals?')) {
        saveWishlist([]);
        window.renderElvoraWishlistModal();
        window.showElvoraToast('Favorites cleared');
      }
    };

    window.addWishlistItemToCart = function(variantId, encodedTitle, btn) {
      const title = decodeURIComponent(encodedTitle || '');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span>Adding...</span>';
      btn.disabled = true;

      const formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');

      fetch('/cart/add.js', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      })
      .then(res => res.json())
      .then(item => {
        btn.innerHTML = '<span>✓ Added!</span>';
        btn.style.background = 'linear-gradient(135deg, #15803d 0%, #166534 100%)';
        btn.style.borderColor = '#86efac';

        fetch('/cart.js')
          .then(r => r.json())
          .then(cart => {
            window.updateElvoraCartBadge(cart.item_count);
            window.showElvoraToast(`✨ ${title || 'Item'} added to cart! (${cart.item_count} in cart)`);
          });

        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.style.background = '';
          btn.style.borderColor = '';
          btn.disabled = false;
        }, 1500);
      })
      .catch(err => {
        btn.innerHTML = originalText;
        btn.disabled = false;
        window.showElvoraToast('Could not add to cart. Please try again.');
      });
    };

    // ── 6. Global Wishlist Card Toggle ──
    window.toggleElvoraWishlist = function(btn, event) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      const variantId = btn.getAttribute('data-variant-id');
      const productId = btn.getAttribute('data-product-id');
      const title = btn.getAttribute('data-product-title') || 'Product';
      const price = btn.getAttribute('data-product-price') || '';
      const image = btn.getAttribute('data-product-image') || '';
      const url = btn.getAttribute('data-product-url') || '';

      const list = getWishlist();
      const existingIdx = list.findIndex(item => item.variantId === variantId || (variantId && item.variantId === variantId) || item.id === productId);

      if (existingIdx > -1) {
        list.splice(existingIdx, 1);
        saveWishlist(list);
        btn.classList.remove('is-active');
        window.showElvoraToast(`Removed ${title} from favorites`);
      } else {
        list.push({
          id: productId,
          variantId: variantId,
          title: title,
          price: price,
          image: image,
          url: url
        });
        saveWishlist(list);
        btn.classList.add('is-active');
        window.showElvoraToast(`❤️ Saved ${title} to favorites!`);
      }

      if (wishlistModal && wishlistModal.classList.contains('is-open')) {
        window.renderElvoraWishlistModal();
      }
    };

    // ── 7. Global AJAX Add to Cart (Stays on page, increments badge, shows toast) ──
    window.elvoraAjaxAddToCart = function(form, event, productTitle) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.elvora-atc-btn');
      const originalHtml = submitBtn ? submitBtn.innerHTML : '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span>Adding...</span>`;
      }

      const formData = new FormData(form);

      fetch('/cart/add.js', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      })
      .then(res => {
        if (!res.ok) throw new Error('Cart add failed');
        return res.json();
      })
      .then(data => {
        if (submitBtn) {
          submitBtn.innerHTML = `<span>✓ Added</span>`;
          submitBtn.style.background = 'linear-gradient(135deg, #15803d 0%, #166534 100%)';
          submitBtn.style.borderColor = '#86efac';
        }

        fetch('/cart.js')
          .then(r => r.json())
          .then(cart => {
            window.updateElvoraCartBadge(cart.item_count);
            window.showElvoraToast(`✨ ${productTitle || 'Item'} added to cart! (${cart.item_count} items in cart)`);
          });

        setTimeout(() => {
          if (submitBtn) {
            submitBtn.innerHTML = originalHtml;
            submitBtn.style.background = '';
            submitBtn.style.borderColor = '';
            submitBtn.disabled = false;
          }
        }, 1500);
      })
      .catch(err => {
        console.error('AJAX add to cart error:', err);
        if (submitBtn) {
          submitBtn.innerHTML = originalHtml;
          submitBtn.disabled = false;
        }
        window.showElvoraToast('Could not add to cart. Please try again.');
      });
    };

    // ── 8. Global Floating Toast Notification System ──
    window.showElvoraToast = function(message) {
      let toast = document.getElementById('elvora-global-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'elvora-global-toast';
        toast.className = 'elvora-global-toast';
        document.body.appendChild(toast);
      }
      toast.innerHTML = `
        <div class="elvora-toast-content">
          <span>${message}</span>
        </div>
      `;
      toast.classList.add('is-visible');
      clearTimeout(window.elvoraToastTimer);
      window.elvoraToastTimer = setTimeout(() => {
        toast.classList.remove('is-visible');
      }, 3200);
    };

    // ── 9. Expose updateCartBadge helper ──
    window.updateElvoraCartBadge = function(newCount) {
      const badge = document.getElementById('elvora-cart-badge');
      const cartBtn = document.getElementById('elvora-cart-trigger');
      if (badge) {
        badge.textContent = newCount;
      }
      if (cartBtn) {
        if (parseInt(newCount, 10) > 0) {
          cartBtn.classList.add('has-items');
        } else {
          cartBtn.classList.remove('has-items');
        }
      }
    };

    // Initial sync
    window.syncWishlistBadges();
  })();
</script>

