{% comment %}
  ELVORA Skincare - Luxury Customer Login Section
  Functional Requirement: User registration and login system
{% endcomment %}

<div class="elvora-auth-page-wrapper">
  <div class="elvora-auth-container">
    
    <!-- Top Breadcrumb / Back Link -->
    <div class="elvora-auth-top-nav">
      <a href="/" class="elvora-auth-back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Back to ELVORA Store</span>
      </a>
    </div>

    <div class="elvora-auth-grid">
      <!-- Left Column: Login Card & Recover Card -->
      <div class="elvora-auth-form-card">
        
        <!-- Recover Password Form (Hidden by default, shown if #recover) -->
        <div id="elvora-recover-box" class="elvora-recover-section" style="display: none;">
          <div class="elvora-auth-header">
            <span class="elvora-auth-kicker">Account Security</span>
            <h1 class="elvora-auth-title">Reset Your Password</h1>
            <p class="elvora-auth-subtitle">
              Enter your registered email address below. We'll send you a secure link to reset your account password.
            </p>
          </div>

          {% form 'recover_customer_password', class: 'elvora-auth-form' %}
            {% if form.errors %}
              <div class="elvora-auth-alert elvora-auth-alert-error" role="alert">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            {% if form.posted_successfully? %}
              <div class="elvora-auth-alert elvora-auth-alert-success" role="alert">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Password reset instructions have been sent to your email. Please check your inbox.</span>
              </div>
            {% endif %}

            <div class="elvora-form-field">
              <label for="RecoverEmail" class="elvora-form-label">Email Address *</label>
              <div class="elvora-input-wrap">
                <input
                  type="email"
                  name="email"
                  id="RecoverEmail"
                  class="elvora-form-input"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="name@example.com"
                  required
                >
                <span class="elvora-input-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="elvora-auth-actions">
              <button type="submit" class="elvora-btn-auth-primary">
                <span>Send Reset Link</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </button>
              <button type="button" id="elvora-cancel-recover-btn" class="elvora-btn-auth-text">
                Cancel and return to login
              </button>
            </div>
          {% endform %}
        </div>

        <!-- Main Customer Login Form -->
        <div id="elvora-login-box" class="elvora-login-section">
          <div class="elvora-auth-header">
            <span class="elvora-auth-kicker">Clinical Skincare Portal</span>
            <h1 class="elvora-auth-title">Welcome Back to ELVORA</h1>
            <p class="elvora-auth-subtitle">
              Sign in to manage your skincare orders, track Cash on Delivery shipments, and access personalized routine recommendations.
            </p>
          </div>

          {% form 'customer_login', class: 'elvora-auth-form' %}
            {% if form.errors %}
              <div class="elvora-auth-alert elvora-auth-alert-error" role="alert">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            <!-- Email Field -->
            <div class="elvora-form-field">
              <label for="CustomerEmail" class="elvora-form-label">Email Address *</label>
              <div class="elvora-input-wrap">
                <input
                  type="email"
                  name="customer[email]"
                  id="CustomerEmail"
                  class="elvora-form-input"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="name@example.com"
                  required
                >
                <span class="elvora-input-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
              </div>
            </div>

            <!-- Password Field -->
            <div class="elvora-form-field">
              <div class="elvora-label-row">
                <label for="CustomerPassword" class="elvora-form-label">Password *</label>
                <a href="#recover" id="elvora-forgot-pwd-link" class="elvora-forgot-link">Forgot Password?</a>
              </div>
              <div class="elvora-input-wrap">
                <input
                  type="password"
                  name="customer[password]"
                  id="CustomerPassword"
                  class="elvora-form-input"
                  autocomplete="current-password"
                  placeholder="••••••••"
                  required
                >
                <button type="button" class="elvora-toggle-pwd-btn" onclick="togglePasswordVisibility('CustomerPassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                  <svg class="pwd-eye-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="elvora-auth-actions">
              <button type="submit" class="elvora-btn-auth-primary">
                <span>Sign In to Account</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
              </button>
            </div>

            <!-- Alternative / Switch to Register -->
            <div class="elvora-auth-footer-note">
              <p>Don't have an ELVORA account yet?</p>
              <a href="/pages/contact?view=register" class="elvora-auth-switch-btn">
                <span>Create an Account</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          {% endform %}
        </div>

      </div>

      <!-- Right Column: Membership & Trust Perks -->
      <div class="elvora-auth-perks-card">
        <div class="elvora-perks-badge">
          <span class="elvora-perks-dot"></span>
          <span>ELVORA Privileges</span>
        </div>
        <h2 class="elvora-perks-title">Your Clinical Skincare Sanctuary</h2>
        <p class="elvora-perks-desc">
          Sign in to unlock personalized skincare tracking, simplified one-click Cash on Delivery, and certified order history.
        </p>

        <ul class="elvora-perks-list">
          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <strong>Instant Order History & Invoices</strong>
              <p>Access your past skincare orders, view COD verification status, and reorder favourite serums with one click.</p>
            </div>
          </li>

          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <strong>Express Cash on Delivery (COD)</strong>
              <p>Save multiple delivery addresses across Pakistan for frictionless checkout without re-entering shipping details.</p>
            </div>
          </li>

          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <strong>Live Courier Tracking</strong>
              <p>Track your package every step of the journey from formulation dispatch to your doorstep delivery.</p>
            </div>
          </li>

          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <strong>24/7 Dedicated Support</strong>
              <p>Direct WhatsApp and phone assistance for skincare consultation and order updates.</p>
            </div>
          </li>
        </ul>

        <div class="elvora-perks-trust-bar">
          <span>🔒 100% Secure SSL Checkout</span>
          <span>🚚 Free Delivery over PKR 3,000</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.style.color = '#B34090';
    } else {
      input.type = 'password';
      btn.style.color = '#9ca3af';
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const loginBox = document.getElementById('elvora-login-box');
    const recoverBox = document.getElementById('elvora-recover-box');
    const forgotLink = document.getElementById('elvora-forgot-pwd-link');
    const cancelRecoverBtn = document.getElementById('elvora-cancel-recover-btn');

    function showRecover() {
      if (loginBox) loginBox.style.display = 'none';
      if (recoverBox) recoverBox.style.display = 'block';
    }

    function showLogin() {
      if (recoverBox) recoverBox.style.display = 'none';
      if (loginBox) loginBox.style.display = 'block';
    }

    if (window.location.hash === '#recover') {
      showRecover();
    }

    if (forgotLink) {
      forgotLink.addEventListener('click', function(e) {
        e.preventDefault();
        showRecover();
        window.location.hash = 'recover';
      });
    }

    if (cancelRecoverBtn) {
      cancelRecoverBtn.addEventListener('click', function(e) {
        e.preventDefault();
        showLogin();
        history.replaceState(null, null, ' ');
      });
    }
  });
</script>

{% schema %}
{
  "name": "Customer Login",
  "settings": [],
  "presets": [
    {
      "name": "Customer Login"
    }
  ]
}
{% endschema %}
