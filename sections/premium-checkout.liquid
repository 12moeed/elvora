<div class="premium-checkout-wrapper" id="checkout-main-container">
  <!-- Breadcrumbs -->
  <nav class="premium-pdp-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/cart">Cart</a>
    <span>/</span>
    <span class="active">Express Checkout</span>
  </nav>

  <!-- Security Header Banner -->
  <div class="premium-checkout-brand-banner">
    <div class="brand-info">
      <span class="eyebrow">✨ ELVORA CLINICAL SKINCARE</span>
      <h1 class="checkout-heading">1-Page Express Checkout</h1>
    </div>
    <div class="security-badge">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <span>256-Bit SSL Encrypted & Verified</span>
    </div>
  </div>

  <div class="premium-checkout-layout">
    <!-- Left Column: Customer & Delivery Address Form -->
    <div class="premium-checkout-form-column">
      <form id="elvora-checkout-form" onsubmit="handlePlaceOrder(event)">
        <!-- Step 1: Contact Information -->
        <div class="checkout-card">
          <div class="checkout-card-header">
            <span class="step-num">1</span>
            <h2>Contact Information</h2>
          </div>
          <div class="checkout-card-body">
            <div class="form-group">
              <label for="cust-name">Full Name <span class="required">*</span></label>
              <input type="text" id="cust-name" required placeholder="e.g. Ayesha Khan" class="premium-input">
            </div>

            <div class="form-row">
              <div class="form-group flex-1">
                <label for="cust-phone">WhatsApp / Mobile Number <span class="required">*</span></label>
                <input type="tel" id="cust-phone" required placeholder="03XX XXXXXXX" class="premium-input">
                <small class="input-hint">Rider will call this number prior to delivery.</small>
              </div>
              <div class="form-group flex-1">
                <label for="cust-email">Email Address <span class="required">*</span></label>
                <input type="email" id="cust-email" required placeholder="name@example.com" class="premium-input">
                <small class="input-hint">For order tracking & receipt.</small>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2: Pakistan Shipping Address -->
        <div class="checkout-card">
          <div class="checkout-card-header">
            <span class="step-num">2</span>
            <h2>Delivery Address (Pakistan)</h2>
          </div>
          <div class="checkout-card-body">
            <div class="form-row">
              <div class="form-group" style="flex: 0.8;">
                <label for="cust-house">House / Apt / Plaza # <span class="required">*</span></label>
                <input type="text" id="cust-house" required placeholder="e.g. House 42-B" class="premium-input">
              </div>
              <div class="form-group flex-1">
                <label for="cust-street">Street Address / Block <span class="required">*</span></label>
                <input type="text" id="cust-street" required placeholder="e.g. Street 4, Sector F-8/2" class="premium-input">
              </div>
            </div>

            <div class="form-group">
              <label for="cust-landmark">Nearby Famous Landmark (Optional)</label>
              <input type="text" id="cust-landmark" placeholder="e.g. Near Shell Pump, Opposite City Hospital" class="premium-input">
            </div>

            <div class="form-row">
              <div class="form-group flex-1">
                <label for="cust-city">City / District <span class="required">*</span></label>
                <select id="cust-city" required class="premium-input" onchange="updateCheckoutCity(this.value)">
                  <option value="" disabled selected>Select Your City...</option>
                  <option value="Lahore">Lahore</option>
                  <option value="Karachi">Karachi</option>
                  <option value="Islamabad">Islamabad</option>
                  <option value="Rawalpindi">Rawalpindi</option>
                  <option value="Faisalabad">Faisalabad</option>
                  <option value="Multan">Multan</option>
                  <option value="Peshawar">Peshawar</option>
                  <option value="Quetta">Quetta</option>
                  <option value="Sialkot">Sialkot</option>
                  <option value="Gujranwala">Gujranwala</option>
                  <option value="Hyderabad">Hyderabad</option>
                  <option value="Abbottabad">Abbottabad</option>
                  <option value="Bahawalpur">Bahawalpur</option>
                  <option value="Sargodha">Sargodha</option>
                  <option value="Sukkur">Sukkur</option>
                  <option value="Gujrat">Gujrat</option>
                  <option value="Jhelum">Jhelum</option>
                  <option value="Sahiwal">Sahiwal</option>
                  <option value="Rahim Yar Khan">Rahim Yar Khan</option>
                  <option value="Mardan">Mardan</option>
                  <option value="Swat">Swat</option>
                  <option value="Mirpur AJK">Mirpur (AJK)</option>
                  <option value="Muzaffarabad">Muzaffarabad</option>
                  <option value="Other">Other Pakistan City</option>
                </select>
              </div>

              <div class="form-group flex-1">
                <label for="cust-province">Province <span class="required">*</span></label>
                <select id="cust-province" required class="premium-input">
                  <option value="Punjab">Punjab</option>
                  <option value="Sindh">Sindh</option>
                  <option value="Khyber Pakhtunkhwa">Khyber Pakhtunkhwa</option>
                  <option value="Islamabad Capital">Islamabad Capital</option>
                  <option value="Balochistan">Balochistan</option>
                  <option value="Azad Kashmir">Azad Kashmir</option>
                  <option value="Gilgit-Baltistan">Gilgit-Baltistan</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3: Payment Method -->
        <div class="checkout-card">
          <div class="checkout-card-header">
            <span class="step-num">3</span>
            <h2>Select Payment Method</h2>
          </div>
          <div class="checkout-card-body">
            <div class="payment-methods-list">
              <!-- Method 1: Cash on Delivery -->
              <label class="payment-method-card active">
                <input type="radio" name="payment_method" value="COD" checked onclick="selectPaymentMethod('COD')">
                <div class="payment-method-content">
                  <div class="title-row">
                    <strong>💵 Cash on Delivery (COD)</strong>
                    <span class="badge-rec">Recommended</span>
                  </div>
                  <p>Pay in cash at your doorstep when your parcel is delivered by our courier rider.</p>
                </div>
              </label>

              <!-- Method 2: Direct Bank / Online -->
              <label class="payment-method-card">
                <input type="radio" name="payment_method" value="Bank" onclick="selectPaymentMethod('Bank')">
                <div class="payment-method-content">
                  <div class="title-row">
                    <strong>🏦 Direct Bank Transfer / JazzCash / Easypaisa</strong>
                  </div>
                  <p>Transfer to our official bank or mobile wallet. Account details shared after placing order.</p>
                </div>
              </label>

              <!-- Method 3: Card -->
              <label class="payment-method-card">
                <input type="radio" name="payment_method" value="Card" onclick="selectPaymentMethod('Card')">
                <div class="payment-method-content">
                  <div class="title-row">
                    <strong>💳 Debit / Credit Card (Visa & Mastercard)</strong>
                  </div>
                  <p>Secure online payment processed through 3D-Secure payment gateway.</p>
                </div>
              </label>
            </div>
          </div>
        </div>

        <!-- Submit Button for Mobile -->
        <div class="mobile-submit-wrap">
          <button type="submit" class="premium-checkout-place-btn" id="mobile-place-btn">
            <span>Place Order • Cash on Delivery</span>
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column: Sticky Live Order Summary -->
    <div class="premium-checkout-summary-column">
      <div class="checkout-summary-card">
        <div class="checkout-summary-head">
          <h3>Your Order Summary</h3>
          <span class="items-badge">
            {% if cart.item_count > 0 %}{{ cart.item_count }} Items{% else %}1 Item (Preview){% endif %}
          </span>
        </div>

        <div class="checkout-items-preview">
          {% if cart.item_count > 0 %}
            {% for item in cart.items %}
              <div class="checkout-item-mini">
                <div class="mini-img-wrap">
                  <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title }}" width="60" height="75">
                  <span class="qty-pill">{{ item.quantity }}</span>
                </div>
                <div class="mini-info">
                  <h4>{{ item.product.title }}</h4>
                  {% unless item.variant.title contains 'Default' %}
                    <span class="variant">{{ item.variant.title }}</span>
                  {% endunless %}
                </div>
                <span class="mini-price">{{ item.final_line_price | money }}</span>
              </div>
            {% endfor %}
          {% else %}
            <p style="color: #6b7280; font-size: 0.9rem; padding: 1.5rem 0; text-align: center;">Your cart is empty. Add products to proceed.</p>
          {% endif %}
        </div>

        <!-- Promo Code Input -->
        <div class="checkout-promo-box">
          <input type="text" id="promo-input" placeholder="Promo / Coupon code" class="promo-input">
          <button type="button" class="promo-btn" onclick="applyPromoCode()">Apply</button>
        </div>
        <div id="promo-message" class="promo-message"></div>

        <!-- Breakdown -->
        <div class="checkout-price-breakdown">
          <div class="breakdown-row">
            <span>Subtotal</span>
            <span id="co-subtotal">{% if cart.item_count > 0 %}{{ cart.total_price | money }}{% else %}Rs. 4,850{% endif %}</span>
          </div>

          <div class="breakdown-row">
            <span>Tracked Express Shipping</span>
            <span class="free-text" id="co-shipping">FREE (All over Pakistan)</span>
          </div>

          <div class="breakdown-row" id="co-discount-row" style="display: none; color: #16a34a;">
            <span>Promo Discount</span>
            <span id="co-discount">-Rs. 500</span>
          </div>

          <div class="breakdown-divider"></div>

          <div class="breakdown-total-row">
            <span class="total-label">Total to Pay:</span>
            <span class="total-amount" id="co-total">{% if cart.item_count > 0 %}{{ cart.total_price | money }}{% else %}Rs. 4,850{% endif %}</span>
          </div>
          <div class="tax-inclusive-tag">Taxes Included • Cash on Delivery</div>
        </div>

        <!-- Submit Button for Desktop -->
        <button type="button" class="premium-checkout-place-btn" onclick="document.getElementById('elvora-checkout-form').requestSubmit();" id="desktop-place-btn">
          <span>Complete Order • Cash on Delivery</span>
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>

        <!-- Perks List -->
        <div class="checkout-perks-box">
          <div class="perk"><span class="icon">📦</span> UV-Protected Temperature Packaging</div>
          <div class="perk"><span class="icon">🚚</span> Delivery in 2 to 4 Business Days</div>
          <div class="perk"><span class="icon">🔄</span> 7-Day Hassle-Free Returns & Exchange</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ORDER CONFIRMATION MODAL / SUCCESS SCREEN -->
<div id="order-success-screen" class="order-success-modal" style="display: none;">
  <div class="success-card">
    <div class="success-icon-wrap">
      <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <span class="success-badge">ORDER PLACED SUCCESSFULLY!</span>
    <h2 class="success-title">Thank You, <span id="success-cust-name">Valued Customer</span>!</h2>
    <p class="success-order-num">Order Tracking #: <strong id="success-order-id">#ELV-84921</strong></p>

    <div class="success-details-box">
      <p>We've received your order and our skincare fulfillment team is preparing your package in temperature-safe, UV-resistant boxes.</p>
      <div class="details-grid">
        <div><strong>Payment:</strong> <span id="success-payment">Cash on Delivery (COD)</span></div>
        <div><strong>Estimated Arrival:</strong> 2 - 4 Business Days</div>
        <div><strong>Delivery City:</strong> <span id="success-city">Lahore</span></div>
        <div><strong>Total Payable:</strong> <span id="success-amount">Rs. 4,850</span></div>
      </div>
    </div>

    <div class="success-actions">
      <a id="success-track-btn" href="/pages/track-order" class="continue-btn" style="background: linear-gradient(135deg, #0E2E4E 0%, #1A4E7E 50%, #0E2E4E 100%); color: #ffffff; border: none; font-weight: 700; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);">
        <span>📦 Track Your Order Now</span>
      </a>
      <a href="https://wa.me/923001234567?text=Hello%20ELVORA,%20I%20have%20placed%20order%20" id="success-whatsapp-btn" target="_blank" class="whatsapp-btn">
        <span>💬 WhatsApp Order Confirmation</span>
      </a>
      <a href="/collections/all" class="continue-btn">
        Continue Shopping
      </a>
    </div>
  </div>
</div>

<script>
function selectPaymentMethod(method) {
  document.querySelectorAll('.payment-method-card').forEach(function(card) {
    card.classList.remove('active');
  });
  var selectedRadio = document.querySelector('input[name="payment_method"][value="' + method + '"]');
  if (selectedRadio) {
    selectedRadio.closest('.payment-method-card').classList.add('active');
  }
  var btnText = method === 'COD' ? 'Complete Order • Cash on Delivery' : 'Place Order & Pay Now';
  var dBtn = document.querySelector('#desktop-place-btn span');
  var mBtn = document.querySelector('#mobile-place-btn span');
  if (dBtn) dBtn.innerText = btnText;
  if (mBtn) mBtn.innerText = btnText;
}

function updateCheckoutCity(city) {
  // Cities logic if needed
}

function applyPromoCode() {
  var input = document.getElementById('promo-input');
  var msg = document.getElementById('promo-message');
  var discRow = document.getElementById('co-discount-row');
  var code = input.value.trim().toUpperCase();

  if (code === 'GLOW10' || code === 'ELVORA' || code === 'SAVE500') {
    msg.innerHTML = '<span style="color: #16a34a; font-weight: 700;">✓ Promo code applied! Rs. 500 discount unlocked.</span>';
    discRow.style.display = 'flex';
  } else if (code === '') {
    msg.innerHTML = '<span style="color: #ef4444;">Please enter a promo code.</span>';
  } else {
    msg.innerHTML = '<span style="color: #ef4444;">Invalid promo code. Try "ELVORA" for test discount.</span>';
  }
}

function handlePlaceOrder(e) {
  e.preventDefault();
  var name = document.getElementById('cust-name').value;
  var phone = document.getElementById('cust-phone').value;
  var city = document.getElementById('cust-city').value;
  var total = document.getElementById('co-total').innerText;
  var paymentRadio = document.querySelector('input[name="payment_method"]:checked');
  var payment = paymentRadio ? paymentRadio.value : 'COD';

  var orderNum = '#ELV-' + Math.floor(10000 + Math.random() * 90000);

  document.getElementById('success-cust-name').innerText = name;
  document.getElementById('success-order-id').innerText = orderNum;
  document.getElementById('success-city').innerText = city;
  document.getElementById('success-amount').innerText = total;
  document.getElementById('success-payment').innerText = payment === 'COD' ? 'Cash on Delivery (COD)' : payment;

  // Set up tracking button link
  var cleanOrderNum = orderNum.replace('#', '');
  var trackBtn = document.getElementById('success-track-btn');
  if (trackBtn) {
    trackBtn.href = '/pages/contact?view=track-order&order=' + encodeURIComponent(cleanOrderNum);
  }

  // Update WhatsApp link
  var waBtn = document.getElementById('success-whatsapp-btn');
  if (waBtn) {
    waBtn.href = 'https://wa.me/923001234567?text=' + encodeURIComponent('Hello ELVORA, I have placed COD order ' + orderNum + ' for ' + total + ' to ' + city + '. Please confirm delivery.');
  }

  // Store in localStorage for recent order history & live order tracking lookup
  try {
    var stored = JSON.parse(localStorage.getItem('elvora_recent_orders') || '[]');
    stored.unshift({
      orderId: orderNum,
      name: name,
      phone: phone,
      city: city,
      total: total,
      payment: payment === 'COD' ? 'Cash on Delivery (COD)' : payment,
      date: new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
      status: 'In Transit with Courier'
    });
    localStorage.setItem('elvora_recent_orders', JSON.stringify(stored.slice(0, 10)));
  } catch(err) {
    console.error('Local order save error:', err);
  }

  // Clear cart in background
  try {
    fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      .catch(function(err) { console.log('Cart clear error:', err); });
  } catch(e) {}

  // Show confirmation screen
  document.getElementById('checkout-main-container').style.display = 'none';
  document.getElementById('order-success-screen').style.display = 'flex';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>

{% schema %}
{
  "name": "Express Checkout Page",
  "tag": "section",
  "class": "section-premium-checkout",
  "settings": []
}
{% endschema %}
