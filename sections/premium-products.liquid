<div class="premium-categories-wrapper">
  <div style="max-width: 1650px; margin: 0 auto; padding: 0 0.5rem; position: relative; z-index: 2;">
    <div class="premium-section-header">
      <div>
        <span class="premium-eyebrow">
          <span class="premium-eyebrow-dot"></span>
          {{ section.settings.eyebrow | default: 'Clinical Formulas' }}
        </span>
        <h2 class="premium-section-title">
          {{ section.settings.title | default: 'Our Skincare Essentials' }}
          <span class="premium-section-title-line"></span>
        </h2>
      </div>

      {% if section.settings.show_view_all %}
        <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="premium-view-all-btn">
          View All
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="premium-product-grid">
      {% assign prod_count = 0 %}
      {% assign target_collection = section.settings.collection %}
      {% if target_collection == blank %}
        {% assign title_h = section.settings.title | handleize %}
        {% if collections[title_h] != blank %}
          {% assign target_collection = collections[title_h] %}
        {% elsif section.settings.sample_preset == 'best_sellers' and collections['best-sellers'] != blank %}
          {% assign target_collection = collections['best-sellers'] %}
        {% elsif section.settings.sample_preset == 'best_sellers' and collections['bestsellers'] != blank %}
          {% assign target_collection = collections['bestsellers'] %}
        {% elsif section.settings.sample_preset == 'new_arrivals' and collections['new-arrivals'] != blank %}
          {% assign target_collection = collections['new-arrivals'] %}
        {% else %}
          {% assign target_collection = collections['all'] %}
        {% endif %}
      {% endif %}

      {% if target_collection != blank and target_collection.products.size > 0 %}
        {% for product in target_collection.products limit: section.settings.products_to_show %}
          {% assign prod_count = prod_count | plus: 1 %}
          {% render 'premium-product-card', product: product %}
        {% endfor %}
      {% endif %}

      {% if prod_count == 0 %}
        <div class="premium-empty-products" style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: #9ca3af;">
          <svg width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin: 0 auto 1rem; color: rgba(255, 255, 255, 0.3);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
          <p style="font-size: 1.05rem; font-weight: 600; color: #f3f4f6; margin-bottom: 0.35rem;">No products added yet</p>
          <p style="font-size: 0.85rem; color: #9ca3af;">Products you add in Shopify Admin will appear here automatically.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium Products (5x2)",
  "tag": "section",
  "class": "section-premium-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Clinical Formulas"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Skincare Essentials"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 5,
      "max": 20,
      "step": 5,
      "default": 10,
      "label": "Products to show (Multiples of 5)"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "select",
      "id": "sample_preset",
      "label": "Sample Data Preset (When collection empty)",
      "options": [
        { "value": "new_arrivals", "label": "New Arrivals" },
        { "value": "best_sellers", "label": "Best Sellers" },
        { "value": "featured", "label": "Featured Formulas" }
      ],
      "default": "new_arrivals"
    }
  ],
  "presets": [
    {
      "name": "Premium Products (5x2)",
      "settings": {
        "title": "New Skincare Arrivals",
        "sample_preset": "new_arrivals"
      }
    }
  ]
}
{% endschema %}