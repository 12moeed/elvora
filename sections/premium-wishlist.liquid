{% comment %}
  ELVORA Skincare - Premium Standalone Wishlist Section
  Renders user's saved favorites from localStorage with direct AJAX Add to Cart & Buy Now checkout.
{% endcomment %}

<div class="elvora-wishlist-page-wrapper">
  <div class="elvora-wishlist-container">
    
    <!-- Breadcrumb & Header -->
    <div class="elvora-wishlist-header-banner">
      <nav class="elvora-wishlist-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">Saved Rituals</span>
      </nav>
      <div class="elvora-wishlist-title-row">
        <div>
          <span class="elvora-eyebrow">
            <span class="elvora-eyebrow-dot"></span>
            Personal Skincare Sanctuary
          </span>
          <h1 class="elvora-wishlist-page-title">My Saved Favorites</h1>
        </div>
        <div class="elvora-wishlist-header-actions" id="elvora-wishlist-header-actions" style="display: none;">
          <button type="button" class="elvora-clear-all-link" onclick="window.clearAllElvoraWishlist()">
            Clear All
          </button>
        </div>
      </div>
    </div>

    <!-- Dynamic Wishlist Grid Mount Point -->
    <div id="elvora-standalone-wishlist-mount" class="elvora-wishlist-grid-mount">
      <div class="elvora-wishlist-loading-state">
        <div class="elvora-spinner"></div>
        <p>Loading your saved formulas...</p>
      </div>
    </div>

  </div>
</div>

<style>
  .elvora-wishlist-page-wrapper {
    min-height: 70vh;
    padding: 3.5rem 1.25rem 6rem;
    background: #FAF6F0;
  }

  .elvora-wishlist-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .elvora-wishlist-header-banner {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(70, 36, 14, 0.12);
  }

  .elvora-wishlist-breadcrumb {
    font-size: 0.85rem;
    color: #784119;
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .elvora-wishlist-breadcrumb a {
    color: #46240E;
    text-decoration: none;
    font-weight: 500;
  }

  .elvora-wishlist-breadcrumb a:hover {
    color: #D4AF37;
    text-decoration: underline;
  }

  .elvora-wishlist-breadcrumb .bc-sep {
    opacity: 0.45;
  }

  .elvora-wishlist-breadcrumb .bc-current {
    font-weight: 700;
    color: #46240E;
  }

  .elvora-wishlist-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .elvora-wishlist-page-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    color: #46240E;
    margin: 0.35rem 0 0;
    letter-spacing: -0.02em;
  }

  .elvora-clear-all-link {
    background: none;
    border: 1px solid rgba(70, 36, 14, 0.25);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #784119;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .elvora-clear-all-link:hover {
    background: #46240E;
    color: #ffffff;
    border-color: #46240E;
  }

  /* Grid of Wishlist Cards */
  .elvora-standalone-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .elvora-standalone-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .elvora-standalone-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .elvora-wishlist-page-title {
      font-size: 1.75rem;
    }
  }

  .elvora-wishlist-card-item {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(70, 36, 14, 0.08);
    border: 1px solid rgba(70, 36, 14, 0.1);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .elvora-wishlist-card-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(70, 36, 14, 0.14);
  }

  .elvora-standalone-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f4eee6;
  }

  .elvora-standalone-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .elvora-wishlist-card-item:hover .elvora-standalone-thumb img {
    transform: scale(1.05);
  }

  .elvora-card-remove-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(70, 36, 14, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #784119;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 5;
  }

  .elvora-card-remove-btn:hover {
    background: #e11d48;
    color: #ffffff;
    border-color: #e11d48;
    transform: scale(1.1);
  }

  .elvora-standalone-details {
    padding: 1.15rem 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .elvora-standalone-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: #46240E;
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }

  .elvora-standalone-title a {
    color: inherit;
    text-decoration: none;
  }

  .elvora-standalone-title a:hover {
    color: #784119;
  }

  .elvora-standalone-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: #784119;
    margin-bottom: 1rem;
  }

  .elvora-standalone-actions {
    margin-top: auto;
    display: flex;
    gap: 8px;
  }

  .elvora-btn-add-cart-solid {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.85rem;
    background: linear-gradient(135deg, #46240E 0%, #784119 50%, #C48739 100%);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .elvora-btn-add-cart-solid:hover {
    filter: brightness(1.1);
    box-shadow: 0 4px 12px rgba(70, 36, 14, 0.3);
  }

  .elvora-btn-buy-now-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.85rem;
    background: transparent;
    color: #46240E;
    border: 1.5px solid #46240E;
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .elvora-btn-buy-now-outline:hover {
    background: #46240E;
    color: #ffffff;
  }

  /* Empty state */
  .elvora-wishlist-standalone-empty {
    text-align: center;
    padding: 5rem 1.5rem;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid rgba(70, 36, 14, 0.12);
    box-shadow: 0 4px 25px rgba(70, 36, 14, 0.05);
  }

  .elvora-empty-heart-wrap {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #D4AF37;
  }

  .elvora-wishlist-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 1.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #46240E 0%, #784119 50%, #C48739 100%);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(70, 36, 14, 0.3);
    transition: all 0.25s ease;
  }

  .elvora-wishlist-explore-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(70, 36, 14, 0.45);
  }
</style>

<script>
window.renderElvoraStandaloneWishlist = function() {
  const mount = document.getElementById('elvora-standalone-wishlist-mount');
  const headerActions = document.getElementById('elvora-wishlist-header-actions');
  if (!mount) return;

  let wishlist = [];
  try {
    wishlist = JSON.parse(localStorage.getItem('elvora_wishlist') || '[]');
  } catch (e) {
    wishlist = [];
  }

  if (headerActions) {
    headerActions.style.display = wishlist.length > 0 ? 'block' : 'none';
  }

  if (wishlist.length === 0) {
    mount.innerHTML = `
      <div class="elvora-wishlist-standalone-empty">
        <div class="elvora-empty-heart-wrap">
          <svg width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </div>
        <h2 style="font-family: var(--font-heading); color: #46240E; font-size: 1.65rem; margin-bottom: 0.5rem; font-weight: 700;">Your Saved Sanctuary is Empty</h2>
        <p style="color: #784119; font-size: 0.95rem; max-width: 480px; margin: 0 auto 1.5rem;">You haven't saved any skincare formulas yet. Click the heart icon (♡) on any product to curate your personalized routine.</p>
        <a href="/collections/all" class="elvora-wishlist-explore-btn">
          <span>Explore All Clinical Formulas</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    `;
    return;
  }

  let html = '<div class="elvora-standalone-grid">';
  wishlist.forEach((item, index) => {
    html += `
      <div class="elvora-wishlist-card-item">
        <div class="elvora-standalone-thumb">
          <a href="${item.url || '#'}" style="display: block; width: 100%; height: 100%;">
            <img src="${item.image || ''}" alt="${escapeHtml(item.title)}" loading="lazy">
          </a>
          <button
            type="button"
            class="elvora-card-remove-btn"
            onclick="window.removeWishlistItemByIndex(${index})"
            title="Remove from favorites"
            aria-label="Remove"
          >
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="elvora-standalone-details">
          <h3 class="elvora-standalone-title">
            <a href="${item.url || '#'}">${escapeHtml(item.title)}</a>
          </h3>
          <div class="elvora-standalone-price">${escapeHtml(item.price)}</div>
          <div class="elvora-standalone-actions">
            ${item.variant_id ? `
              <button
                type="button"
                class="elvora-btn-add-cart-solid"
                onclick="window.addWishlistItemToCart('${item.variant_id}', '${escapeHtml(item.title)}', this)"
              >
                Add to Bag
              </button>
              <a href="/cart/${item.variant_id}:1" class="elvora-btn-buy-now-outline" title="Instant Checkout">
                Buy Now
              </a>
            ` : `
              <a href="${item.url || '#'}" class="elvora-btn-add-cart-solid">View Formula</a>
            `}
          </div>
        </div>
      </div>
    `;
  });
  html += '</div>';

  mount.innerHTML = html;
};

document.addEventListener('DOMContentLoaded', function() {
  window.renderElvoraStandaloneWishlist();
});
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "settings": [],
  "presets": [
    {
      "name": "Wishlist Page"
    }
  ]
}
{% endschema %}

