<div class="premium-collection-header">
  {% if collection.image != blank %}
    <img
      src="{{ collection.image | image_url: width: 1800 }}"
      alt="{{ collection.title | escape }}"
      class="premium-collection-header-bg"
      loading="lazy"
      width="1800"
      height="600"
    >
  {% else %}
    <img
      src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&q=80&w=1800"
      alt="{{ collection.title | escape }}"
      class="premium-collection-header-bg"
      loading="lazy"
      width="1800"
      height="600"
    >
  {% endif %}

  <div class="premium-collection-header-overlay"></div>

  <div class="premium-collection-header-content">
    <!-- Breadcrumbs -->
    <nav class="premium-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="premium-bc-sep">/</span>
      <a href="/collections">Collections</a>
      <span class="premium-bc-sep">/</span>
      <span class="premium-bc-current">{{ collection.title | default: 'All Products' }}</span>
    </nav>

    <!-- Title & Description -->
    <h1 class="premium-collection-title">
      {{ collection.title | default: 'All Products' }}
      <span class="premium-collection-title-underline"></span>
    </h1>

    {% if collection.description != blank %}
      <div class="premium-collection-desc">
        {{ collection.description }}
      </div>
    {% else %}
      <p class="premium-collection-desc">
        Formulated with dermatological precision and clean botanical actives. Explore Elvora's award-winning line of serums, barrier creams, and SPF essentials designed for lasting skin radiance.
      </p>
    {% endif %}

    <!-- Quick Category Filter Pills -->
    <div class="premium-category-pills">
      <a
        href="/collections/all"
        class="premium-pill {% if collection.handle == 'all' or collection.handle == blank %}active{% endif %}"
      >
        All Skincare
      </a>
      <a
        href="/collections/all?category=serums"
        class="premium-pill"
      >
        Serums & Actives
      </a>
      <a
        href="/collections/all?category=cleansers"
        class="premium-pill"
      >
        Cleansers & Toners
      </a>
      <a
        href="/collections/all?category=moisturizers"
        class="premium-pill"
      >
        Barrier Creams
      </a>
      <a
        href="/collections/all?category=sunscreen"
        class="premium-pill"
      >
        Sun Defense (SPF)
      </a>
      <a
        href="/collections/all?category=treatments"
        class="premium-pill"
      >
        Eye & Night Care
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Header",
  "tag": "section",
  "class": "section-collection-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category_pills",
      "label": "Show Quick Category Pills",
      "default": true
    }
  ]
}
{% endschema %}

