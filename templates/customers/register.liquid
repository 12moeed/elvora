{% comment %}
  ELVORA Skincare - Luxury Customer Registration Template
  Functional Requirement: User registration and login system
{% endcomment %}

<div class="elvora-auth-page-wrapper">
  <div class="elvora-auth-container">
    
    <!-- Top Breadcrumb / Back Link -->
    <div class="elvora-auth-top-nav">
      <a href="/" class="elvora-auth-back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Back to ELVORA Store</span>
      </a>
    </div>

    <div class="elvora-auth-grid">
      <!-- Left Column: Registration Card -->
      <div class="elvora-auth-form-card">
        
        <div class="elvora-auth-header">
          <span class="elvora-auth-kicker">Join the ELVORA Circle</span>
          <h1 class="elvora-auth-title">Create Your Account</h1>
          <p class="elvora-auth-subtitle">
            Create an ELVORA account to enjoy seamless Cash on Delivery ordering, order status tracking, and member-only skincare benefits.
          </p>
        </div>

        {% form 'create_customer', class: 'elvora-auth-form' %}
          {% if form.errors %}
            <div class="elvora-auth-alert elvora-auth-alert-error" role="alert">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <span>{{ form.errors | default_errors }}</span>
            </div>
          {% endif %}

          <!-- Name Fields (Row) -->
          <div class="elvora-form-row">
            <div class="elvora-form-field">
              <label for="FirstName" class="elvora-form-label">First Name *</label>
              <div class="elvora-input-wrap">
                <input
                  type="text"
                  name="customer[first_name]"
                  id="FirstName"
                  class="elvora-form-input"
                  {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
                  autocomplete="given-name"
                  placeholder="e.g. Ayesha"
                  required
                >
                <span class="elvora-input-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="elvora-form-field">
              <label for="LastName" class="elvora-form-label">Last Name *</label>
              <div class="elvora-input-wrap">
                <input
                  type="text"
                  name="customer[last_name]"
                  id="LastName"
                  class="elvora-form-input"
                  {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
                  autocomplete="family-name"
                  placeholder="e.g. Khan"
                  required
                >
                <span class="elvora-input-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>

          <!-- Email Field -->
          <div class="elvora-form-field">
            <label for="CustomerEmail" class="elvora-form-label">Email Address *</label>
            <div class="elvora-input-wrap">
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                class="elvora-form-input"
                {% if form.email %}value="{{ form.email }}"{% endif %}
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="name@example.com"
                required
              >
              <span class="elvora-input-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
            </div>
          </div>

          <!-- Phone Number Field (Vital for Pakistan COD order verification) -->
          <div class="elvora-form-field">
            <label for="CustomerPhone" class="elvora-form-label">Mobile Number (For COD Delivery Updates)</label>
            <div class="elvora-input-wrap">
              <input
                type="tel"
                name="customer[note][phone]"
                id="CustomerPhone"
                class="elvora-form-input"
                placeholder="0300 1234567"
                pattern="[0-9+ -]{10,15}"
              >
              <span class="elvora-input-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </span>
            </div>
            <span class="elvora-field-hint">Courier dispatch updates and COD confirmation will be sent here.</span>
          </div>

          <!-- Password Field -->
          <div class="elvora-form-field">
            <label for="CreatePassword" class="elvora-form-label">Password * (Min 6 characters)</label>
            <div class="elvora-input-wrap">
              <input
                type="password"
                name="customer[password]"
                id="CreatePassword"
                class="elvora-form-input"
                autocomplete="new-password"
                placeholder="••••••••"
                minlength="6"
                required
              >
              <button type="button" class="elvora-toggle-pwd-btn" onclick="togglePasswordVisibility('CreatePassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                <svg class="pwd-eye-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Terms Checkbox -->
          <div class="elvora-checkbox-field">
            <label class="elvora-checkbox-label">
              <input type="checkbox" required checked class="elvora-custom-check">
              <span>I agree to receive order notifications, shipping alerts, and skincare updates from ELVORA.</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="elvora-auth-actions">
            <button type="submit" class="elvora-btn-auth-primary">
              <span>Create ELVORA Account</span>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>

          <!-- Switch to Login -->
          <div class="elvora-auth-footer-note">
            <p>Already an ELVORA member?</p>
            <a href="/account/login" class="elvora-auth-switch-btn">
              <span>Sign In to Your Account</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        {% endform %}

      </div>

      <!-- Right Column: Membership Perks -->
      <div class="elvora-auth-perks-card">
        <div class="elvora-perks-badge">
          <span class="elvora-perks-dot"></span>
          <span>Member Privileges</span>
        </div>
        <h2 class="elvora-perks-title">Elevate Your Daily Routine</h2>
        <p class="elvora-perks-desc">
          Joining ELVORA unlocks an elevated skincare journey tailored to your individual skin goals.
        </p>

        <ul class="elvora-perks-list">
          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <strong>Hassle-Free Cash on Delivery</strong>
              <p>Place orders in seconds with pre-saved addresses and pay when your package arrives at your doorstep.</p>
            </div>
          </li>

          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <div>
              <strong>Complete Order History</strong>
              <p>Keep track of all formulations ordered, view batch certificates, and print digital invoices anytime.</p>
            </div>
          </li>

          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
            </div>
            <div>
              <strong>Verified Reviews & Ratings</strong>
              <p>Share your authentic skincare results and earn priority access to limited lab batches.</p>
            </div>
          </li>

          <li class="elvora-perks-item">
            <div class="elvora-perks-icon">
              <svg width="18" height="18" fill="none" stroke="#B34090" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <strong>Dermatologist Verified Quality</strong>
              <p>Zero parabens, 100% cruelty-free, clinical efficacy backed by scientific trials.</p>
            </div>
          </li>
        </ul>

        <div class="elvora-perks-trust-bar">
          <span>🔒 Encrypted Data Protection</span>
          <span>⚡ Same-Day Dispatch</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.style.color = '#B34090';
    } else {
      input.type = 'password';
      btn.style.color = '#9ca3af';
    }
  }
</script>

