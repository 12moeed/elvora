<div class="premium-collection-main">
  <div class="premium-collection-container">
    {% paginate collection.products by section.settings.products_per_page %}
      <!-- Toolbar: Count + Sort -->
      <div class="premium-collection-toolbar">
        <div class="premium-collection-count">
          {% if collection.products_count > 0 %}
            Showing <span class="premium-highlight">{{ collection.products_count }}</span> products in <span class="premium-highlight">{{ collection.title }}</span>
          {% else %}
            Showing <span class="premium-highlight">10</span> products in <span class="premium-highlight">{{ collection.title | default: 'All Products' }}</span>
          {% endif %}
        </div>

        <div class="premium-collection-sort-wrap">
          <label for="premium-sort-by" class="premium-sort-label">Sort by:</label>
          <select id="premium-sort-by" class="premium-sort-select" onchange="location = this.value;">
            {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
            <option value="?sort_by=manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="?sort_by=best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="?sort_by=price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="?sort_by=price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="?sort_by=created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Date: New to Old</option>
          </select>
        </div>
      </div>

      <!-- Product Grid (5 columns on desktop) -->
      <div class="premium-product-grid">
        {% assign items_count = 0 %}
        {% for product in collection.products %}
          {% assign items_count = items_count | plus: 1 %}
          {% render 'premium-product-card', product: product %}
        {% endfor %}

        {% if items_count == 0 %}
          <div class="premium-empty-state" style="grid-column: 1 / -1; text-align: center; padding: 5rem 1rem; color: #9ca3af;">
            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="margin: 0 auto 1rem; color: rgba(255, 255, 255, 0.3);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <p style="font-size: 1.15rem; font-weight: 600; color: #f3f4f6; margin-bottom: 0.5rem;">No products found in this collection.</p>
            <p style="font-size: 0.9rem; color: #9ca3af;">Products added in Shopify Admin will appear here.</p>
          </div>
        {% endif %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <nav class="premium-pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="premium-page-link">← Previous</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="premium-page-link">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="premium-page-link active">{{ part.title }}</span>
              {% else %}
                <span class="premium-page-link">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="premium-page-link">Next →</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 10,
      "max": 30,
      "step": 5,
      "default": 15,
      "label": "Products per page"
    }
  ]
}
{% endschema %}

