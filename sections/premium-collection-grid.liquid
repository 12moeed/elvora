<div class="premium-collection-main">
  <div class="premium-collection-container">
    {% paginate collection.products by section.settings.products_per_page %}
      <!-- Toolbar: Count + Sort -->
      <div class="premium-collection-toolbar">
        <div class="premium-collection-count">
          {% if collection.products_count > 0 %}
            Showing <span class="premium-highlight">{{ collection.products_count }}</span> products in <span class="premium-highlight">{{ collection.title }}</span>
          {% else %}
            Showing <span class="premium-highlight">10</span> products in <span class="premium-highlight">{{ collection.title | default: 'All Products' }}</span>
          {% endif %}
        </div>

        <div class="premium-collection-sort-wrap">
          <label for="premium-sort-by" class="premium-sort-label">Sort by:</label>
          <select id="premium-sort-by" class="premium-sort-select" onchange="location = this.value;">
            {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
            <option value="?sort_by=manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="?sort_by=best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="?sort_by=price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="?sort_by=price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="?sort_by=created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Date: New to Old</option>
          </select>
        </div>
      </div>

      <!-- Product Grid (5 columns on desktop) -->
      <div class="premium-product-grid">
        {% assign items_count = 0 %}
        {% for product in collection.products %}
          {% assign items_count = items_count | plus: 1 %}
          {% render 'premium-product-card', product: product %}
        {% endfor %}

        {% comment %} Fallback dummy cards if collection has no products {% endcomment %}
        {% if items_count == 0 %}
          {% render 'premium-product-card', dummy_title: 'Radiant Glow Vitamin C + Niacinamide Serum', dummy_price: 'Rs. 4,850', dummy_compare_price: 'Rs. 6,500', dummy_category: 'Serums & Actives', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Centella Barrier Relief Repair Cream', dummy_price: 'Rs. 3,800', dummy_compare_price: 'Rs. 4,900', dummy_category: 'Moisturizers', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1608248597359-58807d9b9d36?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Invisible Daily Glow Sunscreen SPF 50+', dummy_price: 'Rs. 3,200', dummy_compare_price: 'Rs. 4,200', dummy_category: 'Sun Protection', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Hyaluronic Acid 2% + B5 Hydration Elixir', dummy_price: 'Rs. 4,200', dummy_compare_price: 'Rs. 5,400', dummy_category: 'Hydration', dummy_badge: 'SALE', dummy_image: 'https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Gentle Oat Amino Foaming Cleanser', dummy_price: 'Rs. 2,600', dummy_compare_price: 'Rs. 3,500', dummy_category: 'Cleansers', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&q=80&w=800' %}
          
          {% render 'premium-product-card', dummy_title: 'Retinol 0.5% Night Cell Renewal Serum', dummy_price: 'Rs. 5,200', dummy_compare_price: 'Rs. 6,800', dummy_category: 'Night Care', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Rose Petal Hydrating Clarifying Toner', dummy_price: 'Rs. 2,400', dummy_compare_price: 'Rs. 3,100', dummy_category: 'Toners', dummy_badge: 'SALE', dummy_image: 'https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'AHA 7% + BHA 2% Peeling Solution', dummy_price: 'Rs. 3,600', dummy_compare_price: 'Rs. 4,600', dummy_category: 'Exfoliators', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1616683693504-3ea7e9ad6fec?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Peptide & Caffeine Dark Circle Eye Cream', dummy_price: 'Rs. 3,900', dummy_compare_price: 'Rs. 5,000', dummy_category: 'Eye Care', dummy_badge: 'HOT', dummy_image: 'https://images.unsplash.com/photo-1535585209827-a15fcdbc4c2d?auto=format&fit=crop&q=80&w=800' %}
          {% render 'premium-product-card', dummy_title: 'Ceramide Rich Barrier Sleeping Mask', dummy_price: 'Rs. 4,500', dummy_compare_price: 'Rs. 5,800', dummy_category: 'Night Masks', dummy_badge: 'NEW', dummy_image: 'https://images.unsplash.com/photo-1567928815116-2f08816c7cfc?auto=format&fit=crop&q=80&w=800' %}
        {% endif %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <nav class="premium-pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="premium-page-link">← Previous</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="premium-page-link">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="premium-page-link active">{{ part.title }}</span>
              {% else %}
                <span class="premium-page-link">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="premium-page-link">Next →</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 10,
      "max": 30,
      "step": 5,
      "default": 15,
      "label": "Products per page"
    }
  ]
}
{% endschema %}

