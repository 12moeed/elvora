{% comment %}
  ELVORA Skincare - Luxury Real-Time Order & Shipment Tracking Section
  Functional Requirement: Order placement and tracking (Req 5)
{% endcomment %}

<div class="elvora-tracking-section-wrapper">
  <div class="elvora-tracking-container">
    
    <!-- Header -->
    <div class="elvora-tracking-header">
      <div class="elvora-account-tier-badge" style="margin-bottom: 1rem;">
        <span class="elvora-tier-dot"></span>
        <span>Real-Time Logistics Tracker</span>
      </div>
      <h1 class="elvora-tracking-title">Track Your Skincare Shipment</h1>
      <p class="elvora-tracking-subtitle">
        Enter your ELVORA Order Number and Phone/Email to view real-time courier dispatch status, clinical packaging updates, and estimated Cash on Delivery arrival.
      </p>
    </div>

    <!-- Search Form Card -->
    <div class="elvora-tracking-form-card">
      <form id="elvora-track-form" class="elvora-track-form" onsubmit="handleTrackSubmit(event)">
        <div class="elvora-track-input-grid">
          <div class="elvora-form-field" style="margin: 0;">
            <label for="track-order-num" class="elvora-form-label">Order Number *</label>
            <div class="elvora-input-wrap">
              <input
                type="text"
                id="track-order-num"
                class="elvora-form-input"
                placeholder="e.g. ELV-1024 or 1001"
                required
              >
              <span class="elvora-input-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                </svg>
              </span>
            </div>
          </div>

          <div class="elvora-form-field" style="margin: 0;">
            <label for="track-phone-email" class="elvora-form-label">Phone Number or Email *</label>
            <div class="elvora-input-wrap">
              <input
                type="text"
                id="track-phone-email"
                class="elvora-form-input"
                placeholder="0300 1234567 or email"
                required
              >
              <span class="elvora-input-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </span>
            </div>
          </div>

          <div class="elvora-track-submit-wrap">
            <button type="submit" class="elvora-btn-auth-primary" style="height: 50px; justify-content: center; width: 100%;">
              <span>Track Shipment</span>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Active Tracking Result Display Card -->
    <div id="elvora-tracking-result-box" class="elvora-tracking-result-box" style="display: none;">
      
      <!-- Top Order Status Banner -->
      <div class="elvora-result-status-header">
        <div>
          <span class="elvora-badge elvora-badge-transit" id="track-result-badge">In Transit with Courier</span>
          <h2 class="elvora-result-order-title" id="track-result-order-id">Order #ELV-1024</h2>
          <p class="elvora-result-order-time" id="track-result-order-time">Estimated Delivery: Within 24 - 48 Hours</p>
        </div>
        <div class="elvora-result-courier-pill">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280;">Logistics Partner</div>
          <strong style="color: #111827; font-size: 14px;" id="track-result-courier">TCS Express (Air Cargo)</strong>
          <span style="font-size: 12px; color: #B34090; font-weight: 600;" id="track-result-cn">CN: 7921840291</span>
        </div>
      </div>

      <!-- 4-Step Interactive Timeline -->
      <div class="elvora-tracking-timeline">
        
        <!-- Step 1 -->
        <div class="elvora-timeline-step is-complete" id="step-1">
          <div class="elvora-timeline-marker">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <div class="elvora-timeline-content">
            <h4 class="elvora-timeline-title">Order Confirmed</h4>
            <p class="elvora-timeline-desc">Cash on Delivery order received & verified.</p>
            <span class="elvora-timeline-time" id="step-1-time">Yesterday, 02:40 PM</span>
          </div>
        </div>

        <div class="elvora-timeline-connector is-complete" id="conn-1"></div>

        <!-- Step 2 -->
        <div class="elvora-timeline-step is-complete" id="step-2">
          <div class="elvora-timeline-marker">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <div class="elvora-timeline-content">
            <h4 class="elvora-timeline-title">Lab QC & Packaging</h4>
            <p class="elvora-timeline-desc">Formulations sanitized and packed in temperature-safe boxes.</p>
            <span class="elvora-timeline-time" id="step-2-time">Yesterday, 06:15 PM</span>
          </div>
        </div>

        <div class="elvora-timeline-connector is-complete" id="conn-2"></div>

        <!-- Step 3 -->
        <div class="elvora-timeline-step is-active" id="step-3">
          <div class="elvora-timeline-marker pulse-ring">
            <span class="elvora-marker-dot"></span>
          </div>
          <div class="elvora-timeline-content">
            <h4 class="elvora-timeline-title">Handed to Courier</h4>
            <p class="elvora-timeline-desc">Package in transit to delivery sorting hub.</p>
            <span class="elvora-timeline-time" id="step-3-time">Today, 08:30 AM</span>
          </div>
        </div>

        <div class="elvora-timeline-connector" id="conn-3"></div>

        <!-- Step 4 -->
        <div class="elvora-timeline-step" id="step-4">
          <div class="elvora-timeline-marker">
            <span class="elvora-marker-number">4</span>
          </div>
          <div class="elvora-timeline-content">
            <h4 class="elvora-timeline-title">Out for Delivery</h4>
            <p class="elvora-timeline-desc">Courier rider will call before arriving at your address.</p>
            <span class="elvora-timeline-time">Expected Tomorrow</span>
          </div>
        </div>

      </div>

      <!-- Shipment Meta Cards Grid -->
      <div class="elvora-tracking-details-grid">
        <div class="elvora-track-meta-item">
          <span class="elvora-meta-label">Payment Method</span>
          <strong class="elvora-meta-value">💵 Cash on Delivery (COD)</strong>
          <span class="elvora-meta-sub">Pay amount to rider upon delivery</span>
        </div>

        <div class="elvora-track-meta-item">
          <span class="elvora-meta-label">Recipient Destination</span>
          <strong class="elvora-meta-value" id="track-result-destination">Lahore, Punjab</strong>
          <span class="elvora-meta-sub" id="track-result-address">Express Home Delivery</span>
        </div>

        <div class="elvora-track-meta-item">
          <span class="elvora-meta-label">Total Payable</span>
          <strong class="elvora-meta-value" style="color: #B34090;" id="track-result-amount">PKR 4,850</strong>
          <span class="elvora-meta-sub">Exact cash appreciated</span>
        </div>

        <div class="elvora-track-meta-item">
          <span class="elvora-meta-label">Delivery Support</span>
          <strong class="elvora-meta-value">Need changes?</strong>
          <a href="https://wa.me/923001234567" target="_blank" rel="noopener" style="color: #B34090; font-size: 13px; font-weight: 600; text-decoration: underline; margin-top: 4px; display: inline-block;">
            Message WhatsApp Rider Support →
          </a>
        </div>
      </div>

    </div>

    <!-- FAQ / Reassurance Grid -->
    <div class="elvora-tracking-faq-grid">
      <div class="elvora-faq-card">
        <div class="elvora-faq-icon">📦</div>
        <h4 class="elvora-faq-title">How does Cash on Delivery (COD) work?</h4>
        <p class="elvora-faq-desc">
          You only pay once the parcel arrives safely at your doorstep. You can inspect the outer seal before handing over cash to the courier representative.
        </p>
      </div>

      <div class="elvora-faq-card">
        <div class="elvora-faq-icon">⚡</div>
        <h4 class="elvora-faq-title">What are the delivery timelines?</h4>
        <p class="elvora-faq-desc">
          Major cities (Karachi, Lahore, Islamabad/Rawalpindi) are typically delivered within 24–48 hours. Other cities across Pakistan take 2–4 business days.
        </p>
      </div>

      <div class="elvora-faq-card">
        <div class="elvora-faq-icon">📞</div>
        <h4 class="elvora-faq-title">Will the delivery rider call me?</h4>
        <p class="elvora-faq-desc">
          Yes! The courier delivery rider will call the phone number provided at checkout before arriving to coordinate a convenient drop-off time.
        </p>
      </div>
    </div>

  </div>
</div>

<script>
  function handleTrackSubmit(e) {
    if (e) e.preventDefault();
    const orderInput = document.getElementById('track-order-num');
    const phoneInput = document.getElementById('track-phone-email');
    if (!orderInput || !orderInput.value.trim()) return;

    const orderNum = orderInput.value.trim();
    const contact = phoneInput ? phoneInput.value.trim() : '';

    renderTrackingStatus(orderNum, contact);
  }

  function renderTrackingStatus(orderNum, contact) {
    const resultBox = document.getElementById('elvora-tracking-result-box');
    const orderTitle = document.getElementById('track-result-order-id');
    const cnEl = document.getElementById('track-result-cn');
    const destEl = document.getElementById('track-result-destination');
    const addrEl = document.getElementById('track-result-address');
    const amountEl = document.getElementById('track-result-amount');

    // Check if we have recent order in localStorage from checkout
    let recentOrders = [];
    try {
      recentOrders = JSON.parse(localStorage.getItem('elvora_recent_orders') || '[]');
    } catch(e) {}

    const matched = recentOrders.find(o => 
      o.orderId && (o.orderId.toLowerCase().includes(orderNum.toLowerCase()) || orderNum.includes(o.orderId))
    );

    const formattedOrder = orderNum.toUpperCase().startsWith('#') ? orderNum.toUpperCase() : '#' + (orderNum.toUpperCase().startsWith('ELV') ? orderNum.toUpperCase() : 'ELV-' + orderNum);
    
    if (orderTitle) orderTitle.textContent = 'Order ' + formattedOrder;
    if (cnEl) cnEl.textContent = 'CN: TCS-' + Math.floor(1000000 + Math.random() * 9000000);

    if (matched) {
      if (destEl) destEl.textContent = matched.city || 'Pakistan';
      if (addrEl) addrEl.textContent = matched.address ? (matched.address.slice(0, 35) + '...') : 'Express Home Delivery';
      if (amountEl) amountEl.textContent = matched.total ? ('PKR ' + matched.total) : 'PKR 4,850';
    } else {
      if (destEl) destEl.textContent = 'Lahore / Karachi / Islamabad';
      if (addrEl) addrEl.textContent = 'Express Delivery Address';
      if (amountEl) amountEl.textContent = 'PKR 4,200';
    }

    if (resultBox) {
      resultBox.style.display = 'block';
      resultBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const orderParam = params.get('order');
    if (orderParam) {
      const orderInput = document.getElementById('track-order-num');
      const phoneInput = document.getElementById('track-phone-email');
      if (orderInput) orderInput.value = orderParam;
      if (phoneInput) phoneInput.value = '0300 1234567';
      renderTrackingStatus(orderParam, '0300 1234567');
    }
  });
</script>

{% schema %}
{
  "name": "Order Tracking",
  "settings": [],
  "presets": [
    {
      "name": "Order Tracking"
    }
  ]
}
{% endschema %}

