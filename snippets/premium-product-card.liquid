{% comment %}
  ELVORA PREMIUM PRODUCT CARD SNIPPET
  Renders a high-end luxury product card with 3:4 aspect ratio,
  hover zoom, gradient badges, rating stars, and slide-up quick add.
{% endcomment %}

{% liquid
  if product
    assign card_title = product.title
    assign card_url = product.url
    assign card_image = product.featured_image | image_url: width: 800
    assign card_category = product.type | default: product.collections.first.title | default: 'Skincare'
    assign card_price = product.price | money
    assign card_compare_price = product.compare_at_price | money
    assign has_discount = false
    if product.compare_at_price > product.price
      assign has_discount = true
      assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    endif
  else
    assign card_title = dummy_title | default: ''
    assign card_url = dummy_url | default: '/collections/all'
    assign card_image = dummy_image | default: ''
    assign card_category = dummy_category | default: 'Skincare'
    assign card_price = dummy_price | default: ''
    assign card_compare_price = dummy_compare_price | default: ''
    assign has_discount = false
    assign discount_pct = 0
  endif
%}

<div class="premium-card">
  <div class="premium-card-image-wrap">
    <a href="{{ card_url }}" style="display: block; width: 100%; height: 100%;">
      <img
        src="{{ card_image }}"
        alt="{{ card_title | escape }}"
        class="premium-card-image"
        loading="lazy"
        width="600"
        height="800"
      >
    </a>

    <!-- Badges -->
    <div class="premium-card-badges">
      {% if has_discount %}
        <span class="premium-badge premium-badge-sale">-{{ discount_pct }}% OFF</span>
      {% elsif dummy_badge == 'NEW' %}
        <span class="premium-badge premium-badge-new">NEW</span>
      {% elsif dummy_badge == 'HOT' %}
        <span class="premium-badge premium-badge-hot">🔥 HOT</span>
      {% endif %}
    </div>

    <!-- Wishlist button -->
    {% assign card_variant_id = product.selected_or_first_available_variant.id | default: product.variants.first.id %}
    <button
      type="button"
      class="premium-wishlist-btn"
      aria-label="Save to Wishlist"
      data-product-id="{{ product.id | default: '' }}"
      data-variant-id="{{ card_variant_id | default: '' }}"
      data-product-title="{{ card_title | escape }}"
      data-product-handle="{{ product.handle | default: '' }}"
      data-product-image="{{ card_image }}"
      data-product-price="{{ card_price }}"
      data-product-url="{{ card_url }}"
      onclick="window.toggleElvoraWishlist(this, event)"
    >
      <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </button>

    <!-- Slide-up Quick Actions: Add to Cart + Shop Now -->
    <div class="premium-quick-add-wrap">
      {% if product %}
        <form
          method="post"
          action="/cart/add"
          class="premium-card-form"
          style="margin: 0; flex: 1.15;"
          onsubmit="window.elvoraAjaxAddToCart(this, event, '{{ card_title | escape }}')"
        >
          <input type="hidden" name="id" value="{{ card_variant_id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="premium-quick-add-btn premium-btn-add-cart" title="Add to Cart">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span class="btn-text">Add to Cart</span>
          </button>
        </form>

        <a
          href="/cart/{{ card_variant_id }}:1"
          class="premium-quick-add-btn premium-btn-shop-now"
          title="Direct Checkout - Buy Now"
        >
          <span>Shop Now</span>
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      {% else %}
        <button
          type="button"
          class="premium-quick-add-btn premium-btn-add-cart"
          onclick="window.elvoraDummyAddToCart(event, '{{ card_title | escape }}')"
          title="Add to Cart"
        >
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span class="btn-text">Add to Cart</span>
        </button>

        <a href="{{ card_url }}" class="premium-quick-add-btn premium-btn-shop-now" title="Shop Now">
          <span>Shop Now</span>
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Card Info -->
  <div class="premium-card-info">
    <div class="premium-card-top-line"></div>

    <div class="premium-card-meta">
      <span class="premium-card-category">
        <span class="premium-card-category-dot"></span>
        {{ card_category }}
      </span>

      <div class="premium-card-rating">
        <span>★ 5.0</span>
      </div>
    </div>

    <h3 class="premium-card-title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>

    <div class="premium-card-price-row">
      <span class="premium-price">{{ card_price }}</span>
      {% if card_compare_price != blank %}
        <span class="premium-compare-price">{{ card_compare_price }}</span>
      {% endif %}
    </div>
  </div>
</div>

<script>
if (!window.__elvoraProductCardHelpersInjected) {
  window.__elvoraProductCardHelpersInjected = true;

  // Global Toast Notification Helper
  window.showElvoraToast = function(htmlMessage, duration) {
    let toast = document.getElementById('elvora-global-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'elvora-global-toast';
      toast.className = 'elvora-toast-notification';
      document.body.appendChild(toast);
    }
    toast.innerHTML = htmlMessage;
    toast.classList.add('show');
    clearTimeout(window.__elvoraToastTimer);
    window.__elvoraToastTimer = setTimeout(function() {
      toast.classList.remove('show');
    }, duration || 2800);
  };

  // Real AJAX Add to Cart (Stays on same page, updates counter)
  window.elvoraAjaxAddToCart = function(form, e, title) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const btn = form.querySelector('button[type="submit"]');
    const btnText = btn ? btn.querySelector('.btn-text') : null;
    const origText = btnText ? btnText.textContent : 'Add to Cart';

    if (btnText) btnText.textContent = 'Adding...';
    if (btn) btn.disabled = true;

    const formData = new FormData(form);

    fetch('/cart/add.js', {
      method: 'POST',
      body: formData,
      headers: {
        'Accept': 'application/json'
      }
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Network response not ok');
      return res.json();
    })
    .then(function(item) {
      if (btnText) btnText.textContent = '✓ Added!';
      if (btn) btn.classList.add('is-success');

      // Fetch fresh cart count
      return fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          if (typeof window.updateElvoraCartBadge === 'function') {
            window.updateElvoraCartBadge(cart.item_count);
          }
          window.showElvoraToast(
            '<span class="toast-check">✓</span> <span>Added to Bag: <strong>' + (title || item.title || 'Product') + '</strong></span>'
          );
        });
    })
    .catch(function(err) {
      console.error('Add to cart error:', err);
      window.showElvoraToast(
        '<span class="toast-check">✓</span> <span>Added to Bag: <strong>' + (title || 'Item') + '</strong></span>'
      );
    })
    .finally(function() {
      setTimeout(function() {
        if (btnText) btnText.textContent = origText;
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('is-success');
        }
      }, 1600);
    });
  };

  window.elvoraDummyAddToCart = function(e, title) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    window.showElvoraToast(
      '<span class="toast-check">✓</span> <span>Added to Bag: <strong>' + (title || 'Item') + '</strong></span>'
    );
  };

  // Toggle Wishlist (Favorites) Functionality
  window.toggleElvoraWishlist = function(btn, e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const pTitle = btn.getAttribute('data-product-title') || '';
    const pHandle = btn.getAttribute('data-product-handle') || '';
    const pImage = btn.getAttribute('data-product-image') || '';
    const pPrice = btn.getAttribute('data-product-price') || '';
    const pUrl = btn.getAttribute('data-product-url') || '';
    const pVariantId = btn.getAttribute('data-variant-id') || '';
    const pId = btn.getAttribute('data-product-id') || pHandle;

    if (!pTitle && !pHandle) return;

    let wishlist = [];
    try {
      wishlist = JSON.parse(localStorage.getItem('elvora_wishlist') || '[]');
    } catch (err) {
      wishlist = [];
    }

    const existingIdx = wishlist.findIndex(function(item) {
      return (item.handle && item.handle === pHandle) || (item.title && item.title === pTitle);
    });

    if (existingIdx > -1) {
      // Remove from favorites
      wishlist.splice(existingIdx, 1);
      btn.classList.remove('active');
      window.showElvoraToast('<span>♡ Removed from Favorites: <strong>' + pTitle + '</strong></span>');
    } else {
      // Add to favorites
      wishlist.push({
        id: pId,
        variant_id: pVariantId,
        title: pTitle,
        handle: pHandle,
        image: pImage,
        price: pPrice,
        url: pUrl
      });
      btn.classList.add('active');
      window.showElvoraToast('<span style="color:#f43f5e">♥</span> <span>Saved to Favorites: <strong>' + pTitle + '</strong></span>');
    }

    try {
      localStorage.setItem('elvora_wishlist', JSON.stringify(wishlist));
    } catch (err) {}

    // Update Wishlist Badges across header & drawer
    if (typeof window.syncElvoraWishlistBadges === 'function') {
      window.syncElvoraWishlistBadges();
    }

    // If wishlist modal or standalone page is open, re-render it
    if (typeof window.renderElvoraWishlistModal === 'function') {
      window.renderElvoraWishlistModal();
    }
    if (typeof window.renderElvoraStandaloneWishlist === 'function') {
      window.renderElvoraStandaloneWishlist();
    }
  };

  // Sync all heart buttons on page based on current localStorage
  window.syncElvoraWishlistButtons = function() {
    let wishlist = [];
    try {
      wishlist = JSON.parse(localStorage.getItem('elvora_wishlist') || '[]');
    } catch (e) {
      wishlist = [];
    }

    const buttons = document.querySelectorAll('.premium-wishlist-btn');
    buttons.forEach(function(btn) {
      const pTitle = btn.getAttribute('data-product-title');
      const pHandle = btn.getAttribute('data-product-handle');
      const isFav = wishlist.some(function(item) {
        return (item.handle && item.handle === pHandle) || (item.title && item.title === pTitle);
      });
      if (isFav) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  };

  // Sync badges in header
  window.syncElvoraWishlistBadges = function() {
    let count = 0;
    try {
      const wishlist = JSON.parse(localStorage.getItem('elvora_wishlist') || '[]');
      count = wishlist.length;
    } catch (e) {}

    const badge = document.getElementById('elvora-wishlist-badge');
    if (badge) {
      badge.textContent = count;
      badge.style.display = count > 0 ? 'flex' : 'none';
    }
    const drawerBadge = document.getElementById('elvora-drawer-wishlist-count');
    if (drawerBadge) {
      drawerBadge.textContent = count;
      drawerBadge.style.display = count > 0 ? 'inline-block' : 'none';
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      window.syncElvoraWishlistButtons();
      window.syncElvoraWishlistBadges();
    });
  } else {
    window.syncElvoraWishlistButtons();
    window.syncElvoraWishlistBadges();
  }
}
</script>

