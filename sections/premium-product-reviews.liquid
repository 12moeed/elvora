<!-- Interactive "Write a Review" Modal -->
<div id="elvora-review-modal" class="elvora-modal-overlay" style="display: none;">
  <div class="elvora-modal-card">
    <div class="elvora-modal-header">
      <div>
        <h3 class="elvora-modal-title">Write a Verified Review</h3>
        <p class="elvora-modal-subtitle">Share your skincare routine experience with the ELVORA community</p>
      </div>
      <button type="button" class="elvora-modal-close" onclick="closeReviewModal()">✕</button>
    </div>

    <form id="elvora-review-form" onsubmit="handleReviewSubmit(event)">
      <!-- Star Rating Picker -->
      <div class="elvora-form-field">
        <label class="elvora-form-label">Overall Rating *</label>
        <div class="elvora-star-picker" id="star-picker">
          <span class="star-pick-btn" data-val="1" onclick="selectStarRating(1)">★</span>
          <span class="star-pick-btn" data-val="2" onclick="selectStarRating(2)">★</span>
          <span class="star-pick-btn" data-val="3" onclick="selectStarRating(3)">★</span>
          <span class="star-pick-btn" data-val="4" onclick="selectStarRating(4)">★</span>
          <span class="star-pick-btn is-active" data-val="5" onclick="selectStarRating(5)">★</span>
        </div>
        <input type="hidden" id="review-stars-input" value="5">
      </div>

      <!-- Author Name & Email -->
      <div class="elvora-form-row">
        <div class="elvora-form-field">
          <label class="elvora-form-label">Your Name *</label>
          <input type="text" id="review-name" class="elvora-form-input" placeholder="e.g. Ayesha K." required>
        </div>
        <div class="elvora-form-field">
          <label class="elvora-form-label">City *</label>
          <input type="text" id="review-city" class="elvora-form-input" placeholder="e.g. Lahore / Karachi" required>
        </div>
      </div>

      <!-- Skin Type & Primary Concern -->
      <div class="elvora-form-row">
        <div class="elvora-form-field">
          <label class="elvora-form-label">Your Skin Type *</label>
          <select id="review-skin-type" class="elvora-form-input">
            <option value="Sensitive">Sensitive Skin</option>
            <option value="Dry">Dry / Dehydrated</option>
            <option value="Combination" selected>Combination Skin</option>
            <option value="Oily">Oily & Acne-Prone</option>
            <option value="Normal">Normal Skin</option>
          </select>
        </div>
        <div class="elvora-form-field">
          <label class="elvora-form-label">Primary Concern</label>
          <select id="review-concern" class="elvora-form-input">
            <option value="Barrier Repair">Barrier Repair & Soothing</option>
            <option value="Hydration">Deep Hydration & Dewy Glow</option>
            <option value="Acne & Pores">Acne, Texture & Pores</option>
            <option value="Hyperpigmentation">Dark Spots & Radiance</option>
          </select>
        </div>
      </div>

      <!-- Review Title -->
      <div class="elvora-form-field">
        <label class="elvora-form-label">Review Title *</label>
        <input type="text" id="review-headline" class="elvora-form-input" placeholder="e.g. Holy grail serum for dry skin!" required>
      </div>

      <!-- Review Body -->
      <div class="elvora-form-field">
        <label class="elvora-form-label">Review Details *</label>
        <textarea id="review-comment" class="elvora-form-input" rows="4" placeholder="How does the texture feel? How quickly did you notice results? How was the Cash on Delivery experience?" required></textarea>
      </div>

      <!-- Recommend Checkbox -->
      <div class="elvora-checkbox-field">
        <label class="elvora-checkbox-label">
          <input type="checkbox" id="review-recommend" checked class="elvora-custom-check">
          <span>I would recommend this formulation to a friend</span>
        </label>
      </div>

      <div class="elvora-auth-actions" style="margin-top: 1.25rem;">
        <button type="submit" class="elvora-btn-auth-primary">
          <span>Publish Verified Review</span>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openReviewModal() {
    const modal = document.getElementById('elvora-review-modal');
    if (modal) modal.style.display = 'flex';
  }

  function closeReviewModal() {
    const modal = document.getElementById('elvora-review-modal');
    if (modal) modal.style.display = 'none';
  }

  function selectStarRating(val) {
    const hiddenInput = document.getElementById('review-stars-input');
    if (hiddenInput) hiddenInput.value = val;
    const stars = document.querySelectorAll('#star-picker .star-pick-btn');
    stars.forEach((star, index) => {
      if (index < val) {
        star.classList.add('is-active');
      } else {
        star.classList.remove('is-active');
      }
    });
  }

  function filterReviews(filter, btn) {
    document.querySelectorAll('.elvora-filter-pill').forEach(b => b.classList.remove('is-active'));
    if (btn) btn.classList.add('is-active');

    const cards = document.querySelectorAll('.elvora-review-card');
    cards.forEach(card => {
      if (filter === 'all') {
        card.style.display = 'block';
      } else if (filter === '5star') {
        card.style.display = card.dataset.rating === '5' ? 'block' : 'none';
      } else {
        card.style.display = card.dataset.skintype === filter ? 'block' : 'none';
      }
    });
  }

  function upvoteHelpful(el) {
    if (el.classList.contains('upvoted')) return;
    el.classList.add('upvoted');
    const match = el.textContent.match(/\d+/);
    const count = match ? parseInt(match[0], 10) + 1 : 1;
    el.textContent = '👍 Helpful (' + count + ')';
    el.style.color = '#B34090';
    el.style.fontWeight = '700';
  }

  function handleReviewSubmit(e) {
    e.preventDefault();
    const name = document.getElementById('review-name').value.trim();
    const city = document.getElementById('review-city').value.trim();
    const skinType = document.getElementById('review-skin-type').value;
    const title = document.getElementById('review-headline').value.trim();
    const comment = document.getElementById('review-comment').value.trim();
    const stars = parseInt(document.getElementById('review-stars-input').value, 10) || 5;

    const list = document.getElementById('elvora-reviews-list');
    if (!list) return;

    const initials = name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() || 'VK';
    const starsText = '★'.repeat(stars) + '☆'.repeat(5 - stars);

    const newCard = document.createElement('div');
    newCard.className = 'elvora-review-card is-newly-submitted';
    newCard.dataset.rating = stars;
    newCard.dataset.skintype = skinType.toLowerCase();
    newCard.innerHTML = `
      <div class="elvora-rc-header">
        <div class="elvora-rc-avatar">${initials}</div>
        <div class="elvora-rc-author-info">
          <div class="elvora-rc-name-row">
            <strong class="elvora-rc-name">${name}</strong>
            <span class="elvora-verified-tag">
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Verified Buyer (COD)
            </span>
          </div>
          <div class="elvora-rc-sub-row">
            <span class="elvora-rc-skin-tag">Skin: ${skinType}</span>
            <span class="elvora-rc-date">Just now • ${city}</span>
          </div>
        </div>
      </div>
      <div class="elvora-rc-stars" style="color: #B34090;">${starsText}</div>
      <h4 class="elvora-rc-title">${title}</h4>
      <p class="elvora-rc-body">${comment}</p>
      <div class="elvora-rc-footer">
        <span class="elvora-rc-helpful" onclick="upvoteHelpful(this)">👍 Helpful (1)</span>
        <span class="elvora-rc-recommend">✓ Recommends this product</span>
      </div>
    `;

    list.prepend(newCard);
    closeReviewModal();
    newCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
</script>

