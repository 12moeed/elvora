{% comment %}
  ELVORA Skincare - Sahara Desert Full-Screen GlassView Auth Portal
  Features:
  - Full-screen Sahara Desert golden dunes background (elvora_sahara_dunes.jpg)
  - Continuous ambient drifting golden sand particles in background (Canvas)
  - True crystal-transparent GlassView card (Sign In & Create Account)
  - Interactive Golden Sandstorm Gust ("Andhi / Golden Reet ki Lehar") wave & dust cloud
    that sweeps from one side to the other and flips the card inside the golden mist!
{% endcomment %}

{%- assign init_tab = default_tab | default: 'signin' -%}

<style>
  /* ELVORA Auth Portal - Desert Brown & Sahara Gold Theme Enforcement */
  .elvora-sahara-auth-stage input.elvora-crystal-input,
  .elvora-sahara-auth-stage textarea.elvora-crystal-input,
  .elvora-crystal-form input:not([type='checkbox'], [type='radio']),
  .elvora-crystal-input {
    width: 100% !important;
    padding: 0.85rem 1rem 0.85rem 2.65rem !important;
    background-color: rgba(36, 19, 10, 0.75) !important;
    background: rgba(36, 19, 10, 0.75) !important;
    border: 1.5px solid rgba(229, 195, 122, 0.5) !important;
    border-radius: 12px !important;
    font-size: 13.5px !important;
    color: #FFF6E8 !important;
    font-family: inherit !important;
    transition: all 0.22s ease !important;
    box-sizing: border-box !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.45) !important;
  }

  .elvora-sahara-auth-stage input.elvora-crystal-input::placeholder,
  .elvora-crystal-form input::placeholder {
    color: rgba(235, 210, 180, 0.6) !important;
    opacity: 1 !important;
  }

  .elvora-sahara-auth-stage input.elvora-crystal-input:focus,
  .elvora-crystal-form input:focus {
    outline: none !important;
    background-color: rgba(52, 28, 14, 0.9) !important;
    background: rgba(52, 28, 14, 0.9) !important;
    border-color: #D4AF37 !important;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.4), 0 0 0 3px rgba(212, 175, 55, 0.35) !important;
    color: #FFFFFF !important;
  }

  /* Autofill Desert Brown Fix */
  .elvora-sahara-auth-stage input:-webkit-autofill,
  .elvora-sahara-auth-stage input:-webkit-autofill:hover, 
  .elvora-sahara-auth-stage input:-webkit-autofill:focus {
    -webkit-text-fill-color: #FFF6E8 !important;
    -webkit-box-shadow: 0 0 0px 1000px #26140A inset !important;
    box-shadow: 0 0 0px 1000px #26140A inset !important;
    transition: background-color 5000s ease-in-out 0s !important;
  }

  /* Submit Button - Desert Brown & Amber Gold Gradient */
  .elvora-crystal-submit-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    width: 100% !important;
    padding: 0.95rem 1.5rem !important;
    margin-top: 0.25rem !important;
    background: linear-gradient(135deg, #46240E 0%, #784119 48%, #C48739 100%) !important;
    color: #ffffff !important;
    border: 1.5px solid rgba(245, 215, 150, 0.6) !important;
    border-radius: 12px !important;
    font-size: 13.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    box-shadow: 0 8px 24px rgba(70, 36, 14, 0.55), 0 0 14px rgba(212, 175, 55, 0.3) !important;
    transition: all 0.25s ease !important;
  }

  .elvora-crystal-submit-btn:hover {
    transform: translateY(-2px) !important;
    background: linear-gradient(135deg, #582D12 0%, #8D4D1E 48%, #D89844 100%) !important;
    box-shadow: 0 12px 30px rgba(70, 36, 14, 0.7), 0 0 20px rgba(212, 175, 55, 0.45) !important;
    border-color: #FFE6A3 !important;
  }

  .elvora-crystal-tab-btn.is-active {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.3) 0%, rgba(122, 66, 26, 0.6) 100%) !important;
    border-color: rgba(229, 195, 122, 0.65) !important;
    color: #ffffff !important;
  }
</style>

<div class="elvora-sahara-auth-stage" style="--sahara-bg: url('{{ 'elvora_sahara_dunes.jpg' | asset_url }}');">
  
  <!-- Layer 1: Sahara Desert Full-Screen Backdrop with Slow Ken-Burns Breathe -->
  <div class="elvora-sahara-bg-image" aria-hidden="true"></div>
  <div class="elvora-sahara-vignette" aria-hidden="true"></div>

  <!-- Layer 2: Ambient Drifting Desert Sand Canvas (Halki Halki Reet Behind Card) -->
  <canvas id="elvora-ambient-sand-canvas" class="elvora-sand-canvas-bg" aria-hidden="true"></canvas>

  <!-- Layer 3: Centered 3D Perspective Stage for the Transparent GlassView Card -->
  <div class="elvora-sahara-center-stage">
    <div class="elvora-card-3d-perspective">
      
      <!-- Volumetric Golden Dust Haze Overlay (Swirls over card during transition) -->
      <div id="elvora-dust-cloud-overlay" class="elvora-dust-cloud-overlay" aria-hidden="true">
        <div class="dust-billow dust-billow-1"></div>
        <div class="dust-billow dust-billow-2"></div>
        <div class="dust-billow dust-billow-3"></div>
      </div>

      <!-- True Crystal-Transparent GlassView Card -->
      <div id="elvora-crystal-card" class="elvora-crystal-glass-card">
        
        <!-- Top Specular Shimmer Rim -->
        <div class="elvora-crystal-rim-glow" aria-hidden="true"></div>

        <!-- Card Header -->
        <div class="elvora-crystal-header">
          <div class="elvora-crystal-pill">
            <span class="elvora-crystal-dot"></span>
            <span id="auth-kicker-text">
              {% if init_tab == 'register' %}ELVORA Private Circle{% else %}ELVORA Member Sanctuary{% endif %}
            </span>
          </div>
          <h1 class="elvora-crystal-title" id="auth-main-heading">
            {% if init_tab == 'register' %}Create Your Account{% else %}Welcome Back{% endif %}
          </h1>
          <p class="elvora-crystal-subtitle" id="auth-main-subheading">
            {% if init_tab == 'register' %}
              Join ELVORA for express Cash on Delivery, live shipment tracking & clinical skincare privileges.
            {% else %}
              Sign in to track your Cash on Delivery orders and manage your clinical skincare ritual.
            {% endif %}
          </p>
        </div>

        <!-- Segmented Glass Tab Switcher -->
        <div class="elvora-crystal-tabs" role="tablist">
          <button
            type="button"
            role="tab"
            class="elvora-crystal-tab-btn {% if init_tab != 'register' %}is-active{% endif %}"
            id="tab-btn-signin"
            onclick="triggerSandstormSwitch('signin')"
          >
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            <span>Sign In</span>
          </button>
          <button
            type="button"
            role="tab"
            class="elvora-crystal-tab-btn {% if init_tab == 'register' %}is-active{% endif %}"
            id="tab-btn-register"
            onclick="triggerSandstormSwitch('register')"
          >
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            <span>Create Account</span>
          </button>
        </div>

        <!-- =========================================================
             PANE 1: SIGN IN FORM
             ========================================================= -->
        <div id="auth-signin-pane" class="elvora-crystal-pane {% if init_tab != 'register' %}is-active{% endif %}">
          {% form 'customer_login', class: 'elvora-crystal-form' %}
            {% if form.errors %}
              <div class="elvora-crystal-alert elvora-crystal-alert-error" role="alert">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            <div class="elvora-crystal-field">
              <label for="CustomerEmail" class="elvora-crystal-label">Email Address *</label>
              <div class="elvora-crystal-input-wrap">
                <input
                  type="email"
                  name="customer[email]"
                  id="CustomerEmail"
                  class="elvora-crystal-input"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="name@example.com"
                  required
                >
                <span class="elvora-crystal-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="elvora-crystal-field">
              <div class="elvora-crystal-label-row">
                <label for="CustomerPassword" class="elvora-crystal-label">Password *</label>
                <button type="button" class="elvora-crystal-forgot-link" onclick="triggerSandstormSwitch('recover')">
                  Forgot Password?
                </button>
              </div>
              <div class="elvora-crystal-input-wrap">
                <input
                  type="password"
                  name="customer[password]"
                  id="CustomerPassword"
                  class="elvora-crystal-input"
                  autocomplete="current-password"
                  placeholder="••••••••"
                  required
                >
                <button
                  type="button"
                  class="elvora-crystal-eye-btn"
                  onclick="toggleCrystalPassword('CustomerPassword', this)"
                  title="Show/Hide Password"
                  aria-label="Toggle password visibility"
                >
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </button>
              </div>
            </div>

            <button type="submit" class="elvora-crystal-submit-btn">
              <span>Sign In to ELVORA</span>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <div class="elvora-crystal-switch-prompt">
              <span>Don't have an account yet?</span>
              <button type="button" class="elvora-crystal-switch-link" onclick="triggerSandstormSwitch('register')">
                Create an Account →
              </button>
            </div>
          {% endform %}
        </div>

        <!-- =========================================================
             PANE 2: CREATE AN ACCOUNT FORM
             ========================================================= -->
        <div id="auth-register-pane" class="elvora-crystal-pane {% if init_tab == 'register' %}is-active{% endif %}">
          {% form 'create_customer', class: 'elvora-crystal-form' %}
            {% if form.errors %}
              <div class="elvora-crystal-alert elvora-crystal-alert-error" role="alert">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            <!-- First & Last Name Row -->
            <div class="elvora-crystal-row">
              <div class="elvora-crystal-field">
                <label for="RegFirstName" class="elvora-crystal-label">First Name *</label>
                <div class="elvora-crystal-input-wrap">
                  <input
                    type="text"
                    name="customer[first_name]"
                    id="RegFirstName"
                    class="elvora-crystal-input"
                    {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
                    autocomplete="given-name"
                    placeholder="Ayesha"
                    required
                  >
                  <span class="elvora-crystal-icon">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </span>
                </div>
              </div>

              <div class="elvora-crystal-field">
                <label for="RegLastName" class="elvora-crystal-label">Last Name *</label>
                <div class="elvora-crystal-input-wrap">
                  <input
                    type="text"
                    name="customer[last_name]"
                    id="RegLastName"
                    class="elvora-crystal-input"
                    {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
                    autocomplete="family-name"
                    placeholder="Khan"
                    required
                  >
                  <span class="elvora-crystal-icon">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>

            <!-- Email & Mobile Phone Row -->
            <div class="elvora-crystal-row">
              <div class="elvora-crystal-field">
                <label for="RegEmail" class="elvora-crystal-label">Email Address *</label>
                <div class="elvora-crystal-input-wrap">
                  <input
                    type="email"
                    name="customer[email]"
                    id="RegEmail"
                    class="elvora-crystal-input"
                    {% if form.email %}value="{{ form.email }}"{% endif %}
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="name@example.com"
                    required
                  >
                  <span class="elvora-crystal-icon">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </span>
                </div>
              </div>

              <div class="elvora-crystal-field">
                <label for="RegPhone" class="elvora-crystal-label">Mobile (For COD) *</label>
                <div class="elvora-crystal-input-wrap">
                  <input
                    type="tel"
                    name="customer[note][phone]"
                    id="RegPhone"
                    class="elvora-crystal-input"
                    placeholder="0300 1234567"
                    pattern="[0-9+ -]{10,15}"
                    required
                  >
                  <span class="elvora-crystal-icon">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>

            <!-- Password -->
            <div class="elvora-crystal-field">
              <label for="RegPassword" class="elvora-crystal-label">Create Password * (Min 6 Characters)</label>
              <div class="elvora-crystal-input-wrap">
                <input
                  type="password"
                  name="customer[password]"
                  id="RegPassword"
                  class="elvora-crystal-input"
                  autocomplete="new-password"
                  placeholder="••••••••"
                  minlength="6"
                  required
                >
                <button
                  type="button"
                  class="elvora-crystal-eye-btn"
                  onclick="toggleCrystalPassword('RegPassword', this)"
                  title="Show/Hide Password"
                  aria-label="Toggle password visibility"
                >
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Privilege Badges -->
            <div class="elvora-crystal-perks">
              <span class="crystal-perk-tag">✦ Express COD</span>
              <span class="crystal-perk-tag">✦ Live Order Tracking</span>
              <span class="crystal-perk-tag">✦ Priority Care</span>
            </div>

            <button type="submit" class="elvora-crystal-submit-btn">
              <span>Create ELVORA Account</span>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <div class="elvora-crystal-switch-prompt">
              <span>Already an ELVORA member?</span>
              <button type="button" class="elvora-crystal-switch-link" onclick="triggerSandstormSwitch('signin')">
                Sign In Here →
              </button>
            </div>
          {% endform %}
        </div>

        <!-- =========================================================
             PANE 3: RECOVER PASSWORD FORM
             ========================================================= -->
        <div id="auth-recover-pane" class="elvora-crystal-pane">
          {% form 'recover_customer_password', class: 'elvora-crystal-form' %}
            {% if form.errors %}
              <div class="elvora-crystal-alert elvora-crystal-alert-error" role="alert">
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            {% if form.posted_successfully? %}
              <div class="elvora-crystal-alert elvora-crystal-alert-success" role="alert">
                <span>Reset link sent! Please check your email inbox.</span>
              </div>
            {% endif %}

            <div class="elvora-crystal-field">
              <label for="RecoverCustomerEmail" class="elvora-crystal-label">Registered Email Address *</label>
              <div class="elvora-crystal-input-wrap">
                <input
                  type="email"
                  name="email"
                  id="RecoverCustomerEmail"
                  class="elvora-crystal-input"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="name@example.com"
                  required
                >
                <span class="elvora-crystal-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
              </div>
            </div>

            <button type="submit" class="elvora-crystal-submit-btn">
              <span>Send Password Reset Link</span>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <div class="elvora-crystal-switch-prompt">
              <button type="button" class="elvora-crystal-switch-link" onclick="triggerSandstormSwitch('signin')">
                ← Back to Sign In
              </button>
            </div>
          {% endform %}
        </div>

        <!-- Bottom Security Note -->
        <div class="elvora-crystal-footer">
          <span>🔒 Encrypted Privacy</span>
          <span class="dot-sep">•</span>
          <span>🚚 Cash on Delivery Nationwide</span>
        </div>

      </div>
    </div>
  </div>

  <!-- Layer 4: Foreground Golden Sandstorm Gust Canvas (Andhi / Golden Reet ki Lehar on Tab Switch) -->
  <canvas id="elvora-sandstorm-wave-canvas" class="elvora-sand-canvas-fg" aria-hidden="true"></canvas>

</div>

<script>
  // Password Eye Toggle
  function toggleCrystalPassword(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.style.color = '#f5d08a';
    } else {
      input.type = 'password';
      btn.style.color = 'rgba(255, 245, 230, 0.65)';
    }
  }

  // Current active tab tracker
  window.elvoraCurrentAuthTab = '{{ init_tab }}';
  window.elvoraStormAnimating = false;

  // Instant DOM pane swap helper (called at the peak of the golden sandstorm cloud)
  function applyAuthTabState(targetTab) {
    const signinBtn = document.getElementById('tab-btn-signin');
    const registerBtn = document.getElementById('tab-btn-register');
    const signinPane = document.getElementById('auth-signin-pane');
    const registerPane = document.getElementById('auth-register-pane');
    const recoverPane = document.getElementById('auth-recover-pane');
    const heading = document.getElementById('auth-main-heading');
    const subheading = document.getElementById('auth-main-subheading');
    const kicker = document.getElementById('auth-kicker-text');

    if (signinPane) signinPane.classList.remove('is-active');
    if (registerPane) registerPane.classList.remove('is-active');
    if (recoverPane) recoverPane.classList.remove('is-active');

    if (targetTab === 'register') {
      if (signinBtn) signinBtn.classList.remove('is-active');
      if (registerBtn) registerBtn.classList.add('is-active');
      if (registerPane) registerPane.classList.add('is-active');
      if (kicker) kicker.textContent = 'ELVORA Private Circle';
      if (heading) heading.textContent = 'Create Your Account';
      if (subheading) subheading.textContent = 'Join ELVORA for express Cash on Delivery, live shipment tracking & clinical skincare privileges.';
      history.replaceState(null, null, '#register');
    } else if (targetTab === 'recover') {
      if (recoverPane) recoverPane.classList.add('is-active');
      if (kicker) kicker.textContent = 'Account Recovery';
      if (heading) heading.textContent = 'Reset Your Password';
      if (subheading) subheading.textContent = 'Enter your registered email to receive a secure password reset link.';
      history.replaceState(null, null, '#recover');
    } else {
      if (registerBtn) registerBtn.classList.remove('is-active');
      if (signinBtn) signinBtn.classList.add('is-active');
      if (signinPane) signinPane.classList.add('is-active');
      if (kicker) kicker.textContent = 'ELVORA Member Sanctuary';
      if (heading) heading.textContent = 'Welcome Back';
      if (subheading) subheading.textContent = 'Sign in to track your Cash on Delivery orders and manage your clinical skincare ritual.';
      history.replaceState(null, null, '#signin');
    }

    window.elvoraCurrentAuthTab = targetTab;
  }

  // Trigger the Golden Sandstorm Gust ("Andhi / Golden Reet ki Lehar") & 3D Flip inside the Dust Mist
  function triggerSandstormSwitch(targetTab) {
    if (window.elvoraStormAnimating || window.elvoraCurrentAuthTab === targetTab) return;
    window.elvoraStormAnimating = true;

    const card = document.getElementById('elvora-crystal-card');
    const dustOverlay = document.getElementById('elvora-dust-cloud-overlay');
    const direction = (targetTab === 'register') ? 1 : -1; // 1: Left-to-Right storm, -1: Right-to-Left storm

    // 1. Fire high-velocity Golden Sandstorm Wave on Foreground Canvas
    if (typeof window.spawnGoldenSandstormWave === 'function') {
      window.spawnGoldenSandstormWave(direction);
    }

    // 2. Activate volumetric golden dust cloud & 3D wind-swept card turn
    if (dustOverlay) {
      dustOverlay.classList.remove('storm-ltr', 'storm-rtl');
      void dustOverlay.offsetWidth; // force reflow
      dustOverlay.classList.add(direction === 1 ? 'storm-ltr' : 'storm-rtl');
    }

    if (card) {
      card.classList.remove('sand-flip-ltr', 'sand-flip-rtl');
      void card.offsetWidth;
      card.classList.add(direction === 1 ? 'sand-flip-ltr' : 'sand-flip-rtl');
    }

    // 3. At the exact peak of the golden sand cloud (410ms), swap the form content
    setTimeout(function() {
      applyAuthTabState(targetTab);
    }, 410);

    // 4. Clean up animation classes after the sandstorm wave passes
    setTimeout(function() {
      if (card) card.classList.remove('sand-flip-ltr', 'sand-flip-rtl');
      if (dustOverlay) dustOverlay.classList.remove('storm-ltr', 'storm-rtl');
      window.elvoraStormAnimating = false;
    }, 1050);
  }

  // =========================================================================
  // SAHARA DESERT SAND ENGINE (Ambient Drifting Sand + Golden Sandstorm Gust)
  // =========================================================================
  (function initSaharaSandEngine() {
    const bgCanvas = document.getElementById('elvora-ambient-sand-canvas');
    const fgCanvas = document.getElementById('elvora-sandstorm-wave-canvas');
    if (!bgCanvas || !fgCanvas) return;

    const bgCtx = bgCanvas.getContext('2d');
    const fgCtx = fgCanvas.getContext('2d');

    let width = window.innerWidth;
    let height = window.innerHeight;

    function resizeCanvases() {
      width = window.innerWidth;
      height = window.innerHeight;
      bgCanvas.width = width;
      bgCanvas.height = height;
      fgCanvas.width = width;
      fgCanvas.height = height;
    }
    resizeCanvases();
    window.addEventListener('resize', resizeCanvases);

    // ── 1. Ambient Background Sand Particles (Halki Halki Reet Urti Rahy) ──
    const AMBIENT_COUNT = 160;
    const ambientGrains = [];
    const sandColors = [
      '255, 228, 175', // Warm champagne gold
      '245, 200, 135', // Desert golden amber
      '255, 242, 215', // Sunlit ivory sand
      '230, 175, 110'  // Rich dune bronze
    ];

    for (let i = 0; i < AMBIENT_COUNT; i++) {
      ambientGrains.push({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 2.1 + 0.5,
        vx: Math.random() * 1.3 + 0.45, // Drifting gently right in desert breeze
        vy: (Math.random() - 0.55) * 0.45, // Slight upward lift over dunes
        alpha: Math.random() * 0.65 + 0.15,
        color: sandColors[Math.floor(Math.random() * sandColors.length)],
        phase: Math.random() * Math.PI * 2,
        wobbleSpeed: Math.random() * 0.025 + 0.01
      });
    }

    // Soft floating desert dust wisps in background
    const DUST_WISPS = 8;
    const ambientWisps = [];
    for (let i = 0; i < DUST_WISPS; i++) {
      ambientWisps.push({
        x: Math.random() * width,
        y: height * (0.35 + Math.random() * 0.6),
        radiusX: Math.random() * 260 + 160,
        radiusY: Math.random() * 60 + 30,
        vx: Math.random() * 0.45 + 0.18,
        alpha: Math.random() * 0.07 + 0.03
      });
    }

    // ── 2. Foreground Sandstorm Gust Particles (Golden Reet ki Lehar / Andhi) ──
    let stormParticles = [];
    let stormClouds = [];

    window.spawnGoldenSandstormWave = function(direction) {
      stormParticles = [];
      stormClouds = [];

      const dir = direction === -1 ? -1 : 1;
      const startEdge = dir === 1 ? -120 : width + 120;

      // Spawn 900 high-velocity golden sand grains + streaks
      for (let i = 0; i < 900; i++) {
        const delaySpread = Math.random() * width * 0.85;
        stormParticles.push({
          x: startEdge - (dir * delaySpread),
          y: Math.random() * height,
          vx: dir * (Math.random() * 28 + 22),
          vy: (Math.random() - 0.5) * 5.5,
          size: Math.random() * 3.2 + 0.8,
          length: Math.random() * 38 + 12,
          alpha: Math.random() * 0.85 + 0.2,
          color: sandColors[Math.floor(Math.random() * sandColors.length)],
          turbulence: Math.random() * 0.15
        });
      }

      // Spawn 28 dense volumetric golden dust cloud puffs ("Dhund")
      for (let i = 0; i < 28; i++) {
        const delaySpread = Math.random() * width * 0.55;
        stormClouds.push({
          x: startEdge - (dir * delaySpread),
          y: (height * 0.15) + Math.random() * (height * 0.7),
          vx: dir * (Math.random() * 24 + 20),
          vy: (Math.random() - 0.5) * 2,
          radius: Math.random() * 220 + 150,
          alpha: Math.random() * 0.36 + 0.18
        });
      }
    };

    // ── Main Animation Loop ──
    function renderSandLoop() {
      // 1. Render Ambient Drifting Sand (Background)
      bgCtx.clearRect(0, 0, width, height);

      // Draw soft desert wind wisps
      for (let i = 0; i < ambientWisps.length; i++) {
        const w = ambientWisps[i];
        w.x += w.vx;
        if (w.x - w.radiusX > width) w.x = -w.radiusX;

        const grad = bgCtx.createRadialGradient(w.x, w.y, 10, w.x, w.y, w.radiusX);
        grad.addColorStop(0, `rgba(245, 205, 145, ${w.alpha})`);
        grad.addColorStop(1, 'rgba(245, 205, 145, 0)');
        bgCtx.fillStyle = grad;
        bgCtx.beginPath();
        bgCtx.ellipse(w.x, w.y, w.radiusX, w.radiusY, 0, 0, Math.PI * 2);
        bgCtx.fill();
      }

      // Draw shimmering individual sand grains
      for (let i = 0; i < ambientGrains.length; i++) {
        const g = ambientGrains[i];
        g.phase += g.wobbleSpeed;
        g.x += g.vx;
        g.y += g.vy + Math.sin(g.phase) * 0.25;

        if (g.x > width + 10) g.x = -10;
        if (g.y < -10) g.y = height + 10;
        if (g.y > height + 10) g.y = -10;

        const twinkle = 0.75 + 0.25 * Math.sin(g.phase * 2);
        bgCtx.fillStyle = `rgba(${g.color}, ${g.alpha * twinkle})`;
        bgCtx.beginPath();
        bgCtx.arc(g.x, g.y, g.radius, 0, Math.PI * 2);
        bgCtx.fill();
      }

      // 2. Render Foreground Sandstorm Gust Wave (When Switching Tabs)
      fgCtx.clearRect(0, 0, width, height);

      if (stormClouds.length > 0 || stormParticles.length > 0) {
        // Render volumetric golden dust clouds ("Dhund")
        for (let i = stormClouds.length - 1; i >= 0; i--) {
          const c = stormClouds[i];
          c.x += c.vx;
          c.y += c.vy;

          const grad = fgCtx.createRadialGradient(c.x, c.y, 5, c.x, c.y, c.radius);
          grad.addColorStop(0, `rgba(242, 195, 120, ${c.alpha})`);
          grad.addColorStop(0.5, `rgba(218, 162, 90, ${c.alpha * 0.6})`);
          grad.addColorStop(1, 'rgba(218, 162, 90, 0)');

          fgCtx.fillStyle = grad;
          fgCtx.beginPath();
          fgCtx.arc(c.x, c.y, c.radius, 0, Math.PI * 2);
          fgCtx.fill();

          if ((c.vx > 0 && c.x - c.radius > width + 200) || (c.vx < 0 && c.x + c.radius < -200)) {
            stormClouds.splice(i, 1);
          }
        }

        // Render high-speed golden sand streaks & grains
        fgCtx.lineCap = 'round';
        for (let i = stormParticles.length - 1; i >= 0; i--) {
          const p = stormParticles[i];
          p.x += p.vx;
          p.y += p.vy + Math.sin(p.x * 0.02) * 1.8;

          fgCtx.strokeStyle = `rgba(${p.color}, ${p.alpha})`;
          fgCtx.lineWidth = p.size;
          fgCtx.beginPath();
          fgCtx.moveTo(p.x, p.y);
          fgCtx.lineTo(p.x - (p.vx > 0 ? p.length : -p.length), p.y - p.vy * 0.4);
          fgCtx.stroke();

          if ((p.vx > 0 && p.x - p.length > width + 100) || (p.vx < 0 && p.x + p.length < -100)) {
            stormParticles.splice(i, 1);
          }
        }
      }

      requestAnimationFrame(renderSandLoop);
    }

    requestAnimationFrame(renderSandLoop);
  })();

  // Initialize initial tab state from URL query or hash on page load
  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const viewParam = params.get('view');
    const hash = window.location.hash;

    if (viewParam === 'register' || hash === '#register') {
      applyAuthTabState('register');
    } else if (hash === '#recover') {
      applyAuthTabState('recover');
    } else {
      {% if init_tab == 'register' %}
        applyAuthTabState('register');
      {% else %}
        applyAuthTabState('signin');
      {% endif %}
    }
  });
</script>
