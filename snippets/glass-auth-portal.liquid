{% comment %}
  ELVORA Skincare - Reusable Luxury Full-Screen Glassmorphic Auth Portal
  Accepts parameter: default_tab ('signin' or 'register')
{% endcomment %}

{%- assign init_tab = default_tab | default: 'signin' -%}

<div class="elvora-auth-fullscreen-hero">
  <!-- Top Minimal Floating Navigation -->
  <div class="elvora-auth-floating-nav">
    <a href="/" class="elvora-auth-back-btn">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Return to ELVORA Store</span>
    </a>
    <div class="elvora-auth-brand-monogram">
      <span class="elvora-brand-title-small">ELVORA</span>
      <span class="elvora-brand-subtitle-small">CLINICAL SKINCARE</span>
    </div>
  </div>

  <!-- Centered Floating Glassmorphism Container -->
  <div class="elvora-auth-center-wrap">
    <div class="elvora-glass-auth-card">
      
      <!-- Brand Kicker Badge -->
      <div class="elvora-card-top-meta">
        <div class="elvora-glass-badge">
          <span class="elvora-glass-dot"></span>
          <span>Member Sanctuary</span>
        </div>
        <h1 class="elvora-glass-title" id="auth-main-heading">
          {% if init_tab == 'register' %}Join the ELVORA Circle{% else %}Welcome to ELVORA{% endif %}
        </h1>
        <p class="elvora-glass-subtitle" id="auth-main-subheading">
          {% if init_tab == 'register' %}
            Create your account for express Cash on Delivery, shipment tracking, and personalized routine benefits.
          {% else %}
            Sign in or create your account to unlock express Cash on Delivery, order tracking, and clinical routine care.
          {% endif %}
        </p>
      </div>

      <!-- Segmented Interactive Tab Switcher -->
      <div class="elvora-auth-tab-bar">
        <button type="button" class="elvora-tab-btn {% if init_tab != 'register' %}is-active{% endif %}" id="tab-btn-signin" onclick="switchAuthTab('signin')">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
          </svg>
          <span>Sign In</span>
        </button>
        <button type="button" class="elvora-tab-btn {% if init_tab == 'register' %}is-active{% endif %}" id="tab-btn-register" onclick="switchAuthTab('register')">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
          <span>Create Account</span>
        </button>
      </div>

      <!-- PANE 1: SIGN IN FORM -->
      <div id="auth-signin-pane" class="elvora-auth-pane {% if init_tab != 'register' %}is-active{% endif %}">
        {% form 'customer_login', class: 'elvora-glass-form' %}
          {% if form.errors %}
            <div class="elvora-glass-alert elvora-glass-alert-error" role="alert">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <span>{{ form.errors | default_errors }}</span>
            </div>
          {% endif %}

          <div class="elvora-glass-field">
            <label for="CustomerEmail" class="elvora-glass-label">Email Address *</label>
            <div class="elvora-glass-input-wrap">
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                class="elvora-glass-input"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="name@example.com"
                required
              >
              <span class="elvora-glass-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
            </div>
          </div>

          <div class="elvora-glass-field">
            <div class="elvora-glass-label-row">
              <label for="CustomerPassword" class="elvora-glass-label">Password *</label>
              <button type="button" class="elvora-glass-forgot-btn" onclick="showRecoverPane()">
                Forgot Password?
              </button>
            </div>
            <div class="elvora-glass-input-wrap">
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                class="elvora-glass-input"
                autocomplete="current-password"
                placeholder="••••••••"
                required
              >
              <button type="button" class="elvora-glass-pwd-eye" onclick="togglePasswordVisibility('CustomerPassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="elvora-btn-glass-primary">
            <span>Sign In to Account</span>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>

          <div class="elvora-glass-toggle-hint">
            <span>New to ELVORA?</span>
            <button type="button" class="elvora-glass-inline-btn" onclick="switchAuthTab('register')">
              Create an account now →
            </button>
          </div>
        {% endform %}
      </div>

      <!-- PANE 2: CREATE AN ACCOUNT FORM -->
      <div id="auth-register-pane" class="elvora-auth-pane {% if init_tab == 'register' %}is-active{% endif %}">
        {% form 'create_customer', class: 'elvora-glass-form' %}
          {% if form.errors %}
            <div class="elvora-glass-alert elvora-glass-alert-error" role="alert">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <span>{{ form.errors | default_errors }}</span>
            </div>
          {% endif %}

          <!-- Name Row -->
          <div class="elvora-glass-row">
            <div class="elvora-glass-field">
              <label for="RegFirstName" class="elvora-glass-label">First Name *</label>
              <div class="elvora-glass-input-wrap">
                <input
                  type="text"
                  name="customer[first_name]"
                  id="RegFirstName"
                  class="elvora-glass-input"
                  {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
                  autocomplete="given-name"
                  placeholder="e.g. Ayesha"
                  required
                >
                <span class="elvora-glass-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="elvora-glass-field">
              <label for="RegLastName" class="elvora-glass-label">Last Name *</label>
              <div class="elvora-glass-input-wrap">
                <input
                  type="text"
                  name="customer[last_name]"
                  id="RegLastName"
                  class="elvora-glass-input"
                  {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
                  autocomplete="family-name"
                  placeholder="e.g. Khan"
                  required
                >
                <span class="elvora-glass-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div class="elvora-glass-field">
            <label for="RegEmail" class="elvora-glass-label">Email Address *</label>
            <div class="elvora-glass-input-wrap">
              <input
                type="email"
                name="customer[email]"
                id="RegEmail"
                class="elvora-glass-input"
                {% if form.email %}value="{{ form.email }}"{% endif %}
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="name@example.com"
                required
              >
              <span class="elvora-glass-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
            </div>
          </div>

          <!-- Phone Number for COD -->
          <div class="elvora-glass-field">
            <label for="RegPhone" class="elvora-glass-label">Mobile Number (For Cash on Delivery Updates) *</label>
            <div class="elvora-glass-input-wrap">
              <input
                type="tel"
                name="customer[note][phone]"
                id="RegPhone"
                class="elvora-glass-input"
                placeholder="0300 1234567"
                pattern="[0-9+ -]{10,15}"
                required
              >
              <span class="elvora-glass-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </span>
            </div>
            <span class="elvora-glass-hint">Delivery rider will call/SMS this number before arriving with your parcel.</span>
          </div>

          <!-- Password -->
          <div class="elvora-glass-field">
            <label for="RegPassword" class="elvora-glass-label">Create Password * (Min 6 Characters)</label>
            <div class="elvora-glass-input-wrap">
              <input
                type="password"
                name="customer[password]"
                id="RegPassword"
                class="elvora-glass-input"
                autocomplete="new-password"
                placeholder="••••••••"
                minlength="6"
                required
              >
              <button type="button" class="elvora-glass-pwd-eye" onclick="togglePasswordVisibility('RegPassword', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Quick Perks Pill List -->
          <div class="elvora-glass-perks-row">
            <span class="perk-pill">✓ Express COD</span>
            <span class="perk-pill">✓ Order Tracking</span>
            <span class="perk-pill">✓ Free Returns</span>
          </div>

          <button type="submit" class="elvora-btn-glass-primary">
            <span>Create ELVORA Account</span>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>

          <div class="elvora-glass-toggle-hint">
            <span>Already have an account?</span>
            <button type="button" class="elvora-glass-inline-btn" onclick="switchAuthTab('signin')">
              Sign in here →
            </button>
          </div>
        {% endform %}
      </div>

      <!-- PANE 3: FORGOT / RECOVER PASSWORD -->
      <div id="auth-recover-pane" class="elvora-auth-pane">
        <div class="elvora-recover-top-intro">
          <h3 class="elvora-recover-h3">Reset Account Password</h3>
          <p class="elvora-recover-p">
            Enter your email address below and we'll send you an encrypted link to reset your account password.
          </p>
        </div>

        {% form 'recover_customer_password', class: 'elvora-glass-form' %}
          {% if form.errors %}
            <div class="elvora-glass-alert elvora-glass-alert-error" role="alert">
              <span>{{ form.errors | default_errors }}</span>
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <div class="elvora-glass-alert elvora-glass-alert-success" role="alert">
              <span>Instructions sent! Please check your email inbox to reset your password.</span>
            </div>
          {% endif %}

          <div class="elvora-glass-field">
            <label for="RecoverCustomerEmail" class="elvora-glass-label">Email Address *</label>
            <div class="elvora-glass-input-wrap">
              <input
                type="email"
                name="email"
                id="RecoverCustomerEmail"
                class="elvora-glass-input"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="name@example.com"
                required
              >
              <span class="elvora-glass-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </span>
            </div>
          </div>

          <button type="submit" class="elvora-btn-glass-primary">
            <span>Send Reset Instructions</span>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>

          <div class="elvora-glass-toggle-hint">
            <button type="button" class="elvora-glass-inline-btn" onclick="hideRecoverPane()">
              ← Return to Sign In
            </button>
          </div>
        {% endform %}
      </div>

      <!-- Trust Footer Inside Card -->
      <div class="elvora-glass-trust-footer">
        <span>🔒 256-Bit SSL Encrypted</span>
        <span>•</span>
        <span>🌿 Clinical Quality Guaranteed</span>
      </div>

    </div>
  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.style.color = '#B34090';
    } else {
      input.type = 'password';
      btn.style.color = '#9ca3af';
    }
  }

  function switchAuthTab(tab) {
    const signinBtn = document.getElementById('tab-btn-signin');
    const registerBtn = document.getElementById('tab-btn-register');
    const signinPane = document.getElementById('auth-signin-pane');
    const registerPane = document.getElementById('auth-register-pane');
    const recoverPane = document.getElementById('auth-recover-pane');
    const heading = document.getElementById('auth-main-heading');
    const subheading = document.getElementById('auth-main-subheading');

    if (recoverPane) recoverPane.classList.remove('is-active');

    if (tab === 'register') {
      if (signinBtn) signinBtn.classList.remove('is-active');
      if (registerBtn) registerBtn.classList.add('is-active');
      if (signinPane) signinPane.classList.remove('is-active');
      if (registerPane) registerPane.classList.add('is-active');
      if (heading) heading.textContent = 'Join the ELVORA Circle';
      if (subheading) subheading.textContent = 'Create your account for express Cash on Delivery, shipment tracking, and personalized routine benefits.';
      window.location.hash = 'register';
    } else {
      if (registerBtn) registerBtn.classList.remove('is-active');
      if (signinBtn) signinBtn.classList.add('is-active');
      if (registerPane) registerPane.classList.remove('is-active');
      if (signinPane) signinPane.classList.add('is-active');
      if (heading) heading.textContent = 'Welcome Back to ELVORA';
      if (subheading) subheading.textContent = 'Sign in to access your skincare orders, track Cash on Delivery packages, and view your routine history.';
      window.location.hash = 'signin';
    }
  }

  function showRecoverPane() {
    const signinPane = document.getElementById('auth-signin-pane');
    const registerPane = document.getElementById('auth-register-pane');
    const recoverPane = document.getElementById('auth-recover-pane');
    const heading = document.getElementById('auth-main-heading');
    const subheading = document.getElementById('auth-main-subheading');

    if (signinPane) signinPane.classList.remove('is-active');
    if (registerPane) registerPane.classList.remove('is-active');
    if (recoverPane) recoverPane.classList.add('is-active');
    if (heading) heading.textContent = 'Reset Password';
    if (subheading) subheading.textContent = 'Enter your email address to recover your account credentials.';
  }

  function hideRecoverPane() {
    switchAuthTab('signin');
  }

  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const viewParam = params.get('view');
    const hash = window.location.hash;

    if (viewParam === 'register' || hash === '#register') {
      switchAuthTab('register');
    } else if (hash === '#recover') {
      showRecoverPane();
    } else {
      {% if init_tab == 'register' %}
        switchAuthTab('register');
      {% else %}
        switchAuthTab('signin');
      {% endif %}
    }
  });
</script>
